---
import Base from '../layouts/Base.astro';
import SplitHeading from '../components/SplitHeading.astro';
import Reveal from '../components/Reveal.astro';
import Cta from '../components/Cta.astro';
import WorkList from '../components/WorkList.astro';
import ChapterIndex from '../components/ChapterIndex.astro';
import { publishedWorks as works, pendingWorks } from '../data/works';
import { homeChapters, chapterNo } from '../data/chapters';

/** 챕터 번호·라벨은 data/chapters.ts 의 순서에서 나옵니다. 손으로 매기지 않습니다. */
const ch = (id: string) => {
  const i = homeChapters.findIndex((c) => c.id === id);
  return { no: chapterNo(i), label: homeChapters[i].label };
};

const principles = [
  '한 번 쓰고 사라지는 대신 계속 찾게 되는 제품',
  '기능보다 쓰임이 먼저 이해되는 소프트웨어',
  '작은 불편을 분명하게 해결하는 도구',
  '사용자의 일상에 조용히 자리 잡는 경험',
  '시간이 지나도 다시 사용할 이유가 남는 제품',
];

const process = [
  {
    no: '01',
    title: '무엇이 불편한지 살핍니다',
    body: '제품은 기술이나 유행에서 시작하지 않습니다. 반복적으로 흐름을 끊는 일, 기존 도구가 당연하게 남겨둔 불편에서 출발합니다.',
  },
  {
    no: '02',
    title: '필요한 이유를 분명히 합니다',
    body: '모든 아이디어가 제품이 되어야 하는 것은 아닙니다. 누가 어떤 상황에서 쓰고, 기존 방식보다 무엇이 나아지는지 말할 수 있을 때 시작합니다.',
  },
  {
    no: '03',
    title: '필요한 만큼 만듭니다',
    body: '기능의 수로 가치를 증명하지 않습니다. 핵심 문제를 제대로 해결하는 데 필요한 것에 집중하고, 목적을 흐리는 요소는 덜어냅니다.',
  },
  {
    no: '04',
    title: '실제 사용에 맞게 다듬습니다',
    body: '기능이 작동하는 것과 제품이 완성되는 것은 다릅니다. 속도, 안정성, 예외 상황, 문장처럼 매일 체감하는 부분을 반복해서 손봅니다.',
  },
  {
    no: '05',
    title: '오래 쓸 수 있는 상태로 남깁니다',
    body: '처음 보았을 때의 인상보다, 시간이 지난 뒤에도 계속 사용할 이유가 있는지를 중요하게 생각합니다.',
  },
];

const avoided = [
  '세상을 바꾸겠다는 과장',
  '근거 없는 혁신과 최고의 경험',
  '규모를 실제보다 크게 보이게 하는 언어',
  '기술 자체를 목적으로 내세우는 설명',
  '사용자의 감탄을 먼저 요구하는 문장',
];
---

<Base footerForm={true}>
  <!-- ═══════════════════════════ HERO ═══════════════════════════ -->
  <section
    class="hero"
    data-color-change-section-bg-color="#ffffff"
    data-color-change-section-text-color="#000000"
  >
    <div class="container hero__inner">
      <!-- 소재지는 공개하지 않는다. 라벨 행은 왼쪽 하나로 둔다. -->
      <Reveal animation="fade-in" delay={80} class="hero__labels">
        <span>독립 소프트웨어 스튜디오</span>
      </Reveal>

      <SplitHeading tag="h1" class="hero__title" delay={150}>
        그때까지<br />남아 있으면 좋겠습니다.
      </SplitHeading>

      <div class="hero__foot">
        <Reveal animation="fade-in" delay={900} class="hero__scroll">
          <span class="nectar-scroll-icon" aria-hidden="true"></span>
        </Reveal>

        <Reveal animation="slight-fade-in-from-bottom" delay={620} class="hero__lead">
          <p class="lead">
            2054년, 제가 환갑이 되는 해입니다.
            그 해에도 누군가 이 주소를 눌러 사이트가 열리고,
            앱 하나가 예전처럼 실행되기를 바라며 만듭니다.
          </p>
          {/* 영문 서명(site.tagline)은 히어로에 두지 않는다. 헤드라인과 뜻이 겹쳐
              같은 말을 두 번 하게 된다. 푸터·연락 페이지 하단과 탭 제목에만 남긴다. */}
        </Reveal>
      </div>
    </div>
  </section>

  <ChapterIndex />

  <!-- ═══════════════════════ STATEMENT ═══════════════════════ -->
  <section
    class="section statement"
    data-color-change-section-bg-color="#ffffff"
    data-color-change-section-text-color="#000000"
  >
    <div class="container">
      <SplitHeading tag="p" effect="scroll-opacity-reveal" class="statement__text">
        등대는 배를 부르지 않습니다.
        그저 같은 자리에서 켜져 있습니다.
      </SplitHeading>
    </div>
  </section>

  <!-- ═══════════════════ 01 · 사라진 것들 ═══════════════════ -->
  <section
    id="lost"
    class="section chapter"
    data-color-change-section-bg-color="#000000"
    data-color-change-section-text-color="#ffffff"
  >
    <div class="container">
      <Reveal animation="fade-in" class="chapter__head">
        <p class="eyebrow">
          <span class="eyebrow__index">{ch('lost').no}</span><span>{ch('lost').label}</span>
        </p>
      </Reveal>

      <div class="grid chapter__grid">
        <div class="chapter__title-col">
          <SplitHeading tag="h2" class="chapter__title">
            오래 쓰던 것이<br />사라진 적 있을 겁니다.
          </SplitHeading>
        </div>

        <div class="chapter__body-col">
          <Reveal animation="slight-fade-in-from-bottom" delay={120}>
            <p class="lead">
              어느 날 종료 공지가 뜨고, 로그인이 막히고, 남는 건 즐겨찾기뿐인 일.
              저도 그런 걸 몇 개 잃었습니다.
              사진 몇 장은 건졌지만, 거기 적어둔 글은 못 건졌습니다.
            </p>
            <p class="chapter__quote">
              그때 아쉬웠던 건 기능이 아니라,<br />
              그 안에 쌓인 시간이었습니다.
            </p>
          </Reveal>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════ 02 · 정한 기준 ═══════════════════ -->
  <section
    id="standard"
    class="section chapter"
    data-color-change-section-bg-color="#ffffff"
    data-color-change-section-text-color="#000000"
  >
    <div class="container">
      <Reveal animation="fade-in" class="chapter__head">
        <p class="eyebrow">
          <span class="eyebrow__index">{ch('standard').no}</span><span>{ch('standard').label}</span>
        </p>
      </Reveal>

      <div class="grid chapter__grid">
        <div class="chapter__title-col">
          <SplitHeading tag="h2" class="chapter__title">
            제가 가장 오래 쓰고 있는 건<br />소프트웨어가 아닙니다.
          </SplitHeading>
        </div>
        <div class="chapter__body-col">
          <Reveal animation="slight-fade-in-from-bottom" delay={120}>
            <p class="lead">
              십사 년째 같은 키보드를 씁니다. 스틸시리즈 6Gv2, 요즘은 팔지 않는 모델입니다.
              십 년 넘게 손에 든 라이터도 하나 있습니다.
              그동안 제가 쓰던 소프트웨어는 여러 번 바뀌었고, 몇 개는 아예 사라졌습니다.
            </p>
            <p class="chapter__quote">
              오래 남는 쪽은 늘 물건이었습니다.<br />
              소프트웨어도 그럴 수 있으면 좋겠습니다.
            </p>
          </Reveal>
        </div>
      </div>

      <ul class="principles">
        {
          principles.map((p, i) => (
            <Reveal as="li" animation="slight-fade-in-from-bottom" delay={i * 80} class="principles__item">
              <span class="principles__mark" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <span class="principles__text">{p}</span>
            </Reveal>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ═══════════════════ 03 · 켜 둔 것들 ═══════════════════ -->
  <section
    id="works"
    class="section chapter"
    data-color-change-section-bg-color="#ffffff"
    data-color-change-section-text-color="#000000"
  >
    <div class="container">
      <Reveal animation="fade-in" class="chapter__head">
        <p class="eyebrow">
          <span class="eyebrow__index">{ch('works').no}</span><span>{ch('works').label}</span>
        </p>
      </Reveal>

      <div class="grid chapter__grid">
        <div class="chapter__title-col">
          <SplitHeading tag="h2" class="chapter__title">
            말은 닿지 않습니다.<br />불빛만 닿습니다.
          </SplitHeading>
        </div>
        <div class="chapter__body-col">
          <Reveal animation="slight-fade-in-from-bottom" delay={120}>
            <p class="lead">
              형태는 다르지만 모든 작업은 같은 질문에서 출발합니다.
              이 제품은 왜 필요한가, 누구의 어떤 불편을 해결하는가,
              기존 방식보다 무엇이 분명하게 나아지는가.
            </p>
          </Reveal>
        </div>
      </div>

      <WorkList works={works} pending={pendingWorks} class="works" />

      <Reveal animation="fade-in" class="chapter__cta">
        <Cta href="/work/">작업 전체 보기</Cta>
      </Reveal>
    </div>
  </section>

  <!-- ═════════════ 04 · 등을 세우는 순서 ═════════════ -->
  <section
    id="order"
    class="section chapter"
    data-color-change-section-bg-color="#000000"
    data-color-change-section-text-color="#ffffff"
  >
    <div class="container">
      <Reveal animation="fade-in" class="chapter__head">
        <p class="eyebrow">
          <span class="eyebrow__index">{ch('order').no}</span><span>{ch('order').label}</span>
        </p>
      </Reveal>

      <div class="grid chapter__grid">
        <div class="chapter__title-col">
          <SplitHeading tag="h2" class="chapter__title">
            세우는 데 넷,<br />켜두는 데 하나.
          </SplitHeading>
        </div>
        <div class="chapter__body-col">
          <Reveal animation="slight-fade-in-from-bottom" delay={120}>
            <p class="lead">
              다섯 번의 판단을 거칩니다. 마지막 하나는 출시 다음의 일이고,
              그게 가장 깁니다.
            </p>
          </Reveal>
        </div>
      </div>

      <ol class="process">
        {
          process.map((step) => (
            <Reveal as="li" animation="slight-fade-in-from-bottom" class="process__item">
              <span class="process__no">{step.no}</span>
              <h3 class="process__title">{step.title}</h3>
              <p class="process__body">{step.body}</p>
            </Reveal>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ═══════════════ 05 · 유리를 닦는 일 ═══════════════ -->
  <section
    id="glass"
    class="section chapter"
    data-color-change-section-bg-color="#000000"
    data-color-change-section-text-color="#ffffff"
  >
    <div class="container">
      <Reveal animation="fade-in" class="chapter__head">
        <p class="eyebrow">
          <span class="eyebrow__index">{ch('glass').no}</span><span>{ch('glass').label}</span>
        </p>
      </Reveal>

      <div class="grid chapter__grid">
        <div class="chapter__title-col">
          <SplitHeading tag="h2" class="chapter__title">
            밝기를 올리는 대신<br />유리를 닦습니다.
          </SplitHeading>
        </div>
        <div class="chapter__body-col">
          <Reveal animation="slight-fade-in-from-bottom" delay={120}>
            <p class="lead">
              전환이 끊기는 순간, 아무도 마주치지 않기를 바라는 예외 상황,
              누구도 칭찬하지 않는 문장.
              처음 볼 때는 보이지 않지만 오래 쓰면 반드시 드러나는 것들입니다.
              저는 여기에 시간을 가장 많이 씁니다.
            </p>
          </Reveal>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════ 06 · 곁에 있는 방식 ═══════════════ -->
  <section
    id="beside"
    class="section chapter"
    data-color-change-section-bg-color="#ffffff"
    data-color-change-section-text-color="#000000"
  >
    <div class="container">
      <Reveal animation="fade-in" class="chapter__head">
        <p class="eyebrow">
          <span class="eyebrow__index">{ch('beside').no}</span><span>{ch('beside').label}</span>
        </p>
      </Reveal>

      <div class="grid chapter__grid">
        <div class="chapter__title-col">
          <SplitHeading tag="h2" class="chapter__title">
            좋은 도구는<br />꺼봐야 압니다.
          </SplitHeading>
        </div>
        <div class="chapter__body-col">
          <Reveal animation="slight-fade-in-from-bottom" delay={120}>
            <p class="lead">
              창이 엉킨 채로 오래 작업하던 날, 화면을 정리하는 일이
              작업의 일부가 되어 있다는 걸 알았습니다. Monkey Flash는 거기서 나왔습니다.
              처음 켰을 때 감탄할 만한 것은 없습니다.
              며칠 쓰다 꺼보면 그제야 불편해집니다.
            </p>
            <p class="chapter__quote">
              존재를 알리는 대신,<br />
              없을 때 아쉬운 쪽으로.
            </p>
          </Reveal>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════ 07 · 등대지기 한 사람 ═══════════ -->
  <section
    id="keeper"
    class="section chapter"
    data-color-change-section-bg-color="#ffffff"
    data-color-change-section-text-color="#000000"
  >
    <div class="container">
      <Reveal animation="fade-in" class="chapter__head">
        <p class="eyebrow">
          <span class="eyebrow__index">{ch('keeper').no}</span><span>{ch('keeper').label}</span>
        </p>
      </Reveal>

      <div class="grid chapter__grid">
        <div class="chapter__title-col">
          <SplitHeading tag="h2" class="chapter__title">
            작은 스튜디오라는 사실을<br />감추지 않습니다.
          </SplitHeading>
        </div>
        <div class="chapter__body-col">
          <Reveal animation="slight-fade-in-from-bottom" delay={120}>
            <p class="lead">
              한 사람이 처음부터 마지막까지 만듭니다.
              규모를 크게 보이게 포장하는 대신, 그 사실을 작업 방식으로 보여줍니다.
            </p>
          </Reveal>
        </div>
      </div>

      <Reveal animation="fade-in" delay={200} class="chapter__cta">
        <Cta href="/studio/">스튜디오 이야기</Cta>
      </Reveal>
    </div>
  </section>

  <!-- ═══════════════ 08 · 하지 않는 말 ═══════════════ -->
  <section
    id="unsaid"
    class="section chapter chapter--attitude"
    data-color-change-section-bg-color="#000000"
    data-color-change-section-text-color="#ffffff"
  >
    <div class="container">
      <Reveal animation="fade-in" class="chapter__head">
        <p class="eyebrow">
          <span class="eyebrow__index">{ch('unsaid').no}</span><span>{ch('unsaid').label}</span>
        </p>
      </Reveal>

      <div class="grid chapter__grid">
        <div class="chapter__title-col">
          <SplitHeading tag="h2" class="chapter__title">
            자신감은 큰 목소리에서<br />나오지 않습니다.
          </SplitHeading>
        </div>
        <div class="chapter__body-col">
          <Reveal animation="slight-fade-in-from-bottom" delay={120}>
            <p class="lead">
              문제를 정확하게 이해하고, 실제로 작동하는 제품을 끝까지 완성하는 데서 나옵니다.
              그래서 아래와 같은 표현은 쓰지 않습니다.
            </p>
          </Reveal>
        </div>
      </div>

      <div class="nectar-fancy-ul avoided" data-animation="true" data-list-icon="dot">
        <ul>
          {avoided.map((a) => <li>{a}</li>)}
        </ul>
      </div>

      <Reveal animation="slight-fade-in-from-bottom" delay={120} class="closing">
        <p>
          보여주기 위한 복잡함보다 이해하기 쉬운 구조를,
          순간적인 인상보다 반복해서 사용할 수 있는 완성도를 선택합니다.
        </p>
      </Reveal>
    </div>
  </section>

  <!-- ═══════════════════════ 간주 ═══════════════════════ -->
  {/* 히어로의 문장이 한 번 더 지나가며 페이지가 수미상관으로 닫힙니다.
      반복하거나 흘리지 않습니다 — 소망은 한 번 말하면 다짐이지만
      되풀이하면 주문처럼 들립니다. 사이트에서 유일하게 가운데 정렬입니다. */}
  <section
    class="interlude"
    data-color-change-section-bg-color="#000000"
    data-color-change-section-text-color="#ffffff"
  >
    <div class="container">
      <SplitHeading tag="p" class="interlude__line">
        그때까지<br />남아 있으면 좋겠습니다.
      </SplitHeading>

      {/* 편지 끝의 서명. 사업자명이 이름값을 하는 유일한 자리다. */}
      <Reveal animation="fade-in" delay={420} class="interlude__sign">
        <span class="interlude__dash" aria-hidden="true">—</span>
        <span class="interlude__name">기억</span>
      </Reveal>
    </div>
  </section>
</Base>

<style>
  /* ───────────── Hero ───────────── */
  .hero {
    min-height: 100svh;
    display: flex;
    align-items: stretch;
    /* 아래 여백은 취향이 아니라 필요다. 히어로 리드는 등장 waypoint(뷰포트 88%)
       위에 있어야 첫 화면에서 스스로 나타난다. 여백을 줄이면 리드가 그 선 아래로
       내려가 스크롤하기 전까지 보이지 않는다. */
    padding-block: clamp(100px, 12vh, 150px) clamp(72px, 9vh, 110px);
  }

  .hero__inner {
    width: 100%;
    display: flex;
    flex-direction: column;
  }

  .hero__labels {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    font-size: var(--fs-meta);
    letter-spacing: 0.13em;
    text-transform: uppercase;
    opacity: 0.45;
    padding-bottom: clamp(1.5rem, 3vw, 2.5rem);
    border-bottom: 1px solid;
    border-color: color-mix(in srgb, currentColor 14%, transparent);
  }

  .hero__title {
    margin-top: auto;
    padding-top: clamp(2rem, 5vw, 4rem);
    font-size: var(--fs-display);
    font-weight: 600;
    letter-spacing: -0.055em;
  }

  .hero__title :global(h1) {
    line-height: 1.16;
  }

  .hero__foot {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(16px, 2vw, 40px);
    align-items: end;
    margin-top: auto;
    padding-top: clamp(2.5rem, 5vw, 4.5rem);
  }

  .hero__scroll {
    grid-column: 1 / span 2;
  }

  .hero__lead {
    grid-column: 7 / span 5;
  }

  .hero__lead .lead {
    max-width: 44ch;
    opacity: 0.7;
  }

  @media (max-width: 900px) {
