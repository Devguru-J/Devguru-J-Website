---
import Base from '../layouts/Base.astro';
import SplitHeading from '../components/SplitHeading.astro';
import Reveal from '../components/Reveal.astro';
import Cta from '../components/Cta.astro';
---

<Base title="찾을 수 없는 페이지" hideFooter={true}>
  <section
    class="nf"
    data-color-change-section-bg-color="#ffffff"
    data-color-change-section-text-color="#000000"
  >
    <div class="container">
      <Reveal animation="fade-in">
        <p class="eyebrow"><span class="eyebrow__index">404</span><span>없는 페이지</span></p>
      </Reveal>

      <SplitHeading tag="h1" class="nf__title" delay={100}>
        여기에는<br />아무것도 없습니다.
      </SplitHeading>

      <Reveal animation="slight-fade-in-from-bottom" delay={420} class="nf__body">
        <p class="lead">주소가 바뀌었거나, 아직 만들지 않은 페이지입니다.</p>
        <div class="nf__cta"><Cta href="/">처음으로 돌아가기</Cta></div>
      </Reveal>
    </div>
  </section>
</Base>

<style>
  .nf {
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding-block: clamp(140px, 18vh, 220px);
  }

  .nf .container {
    width: 100%;
  }

  .nf__title {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    font-size: var(--memory-fs-h1);
    letter-spacing: -0.055em;
  }

  .nf__body {
    margin-top: clamp(2.5rem, 4vw, 3.5rem);
  }

  .nf__body .lead {
    opacity: 0.55;
  }

  .nf__cta {
    margin-top: 2.5rem;
    font-size: 1.0625rem;
    font-weight: 500;
  }
</style>
