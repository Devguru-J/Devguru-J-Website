---
import '../styles/global.css';
import SiteHeader from '../components/global/SiteHeader.astro';
import SiteFooter from '../components/global/SiteFooter.astro';
import { alternateHref, localeHref, t, type Locale } from '../content/site';

interface Props {
  title: string;
  description: string;
  /** locale-agnostic route, e.g. "/work/" — the locale prefix is added here */
  path: string;
  locale: Locale;
  /** absolute-from-root image path used for og:image */
  ogImage?: string;
  /** legal/system pages opt out of the marketing header and footer */
  chrome?: boolean;
  /**
   * false for routes that live at one URL in both languages — the Monkey Flash
   * legal pages toggle their body copy in place instead of having /en/ twins.
   */
  bilingual?: boolean;
}

const {
  title,
  description,
  path,
  locale,
  ogImage,
  chrome = true,
  bilingual = true,
} = Astro.props;
const c = t(locale);

const canonical = new URL(bilingual ? localeHref(locale, path) : path, Astro.site);
const koHref = new URL(localeHref('ko', path), Astro.site);
const enHref = new URL(localeHref('en', path), Astro.site);
const og = new URL(ogImage ?? `/assets/og-cover-${locale}.jpg`, Astro.site);
---

<!doctype html>
<html lang={locale} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      bilingual && (
        <>
          <link rel="alternate" hreflang="ko" href={koHref} />
          <link rel="alternate" hreflang="en" href={enHref} />
          <link rel="alternate" hreflang="x-default" href={koHref} />
        </>
      )
    }
    <link rel="icon" type="image/png" href="/assets/favicon.png" />
    <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png" />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:site_name" content="Memory" />
    <meta property="og:locale" content={locale === 'ko' ? 'ko_KR' : 'en_US'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      document.documentElement.classList.remove('no-js');
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a class="skip" href="#main">{c.skip}</a>
    <div class="grain" aria-hidden="true"></div>
    {chrome && <SiteHeader locale={locale} path={path} alternate={alternateHref(locale, path)} />}
    <main id="main" tabindex="-1">
      <slot />
    </main>
    {chrome && <SiteFooter locale={locale} />}
    <script>
      import '../scripts/site-motion';
    </script>
  </body>
</html>
