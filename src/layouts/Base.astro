---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  hideFooter?: boolean;
  /** 푸터 연락 섹션에 양식을 함께 보일지. 홈에서만 켭니다. */
  footerForm?: boolean;
}

const {
  title,
  description = site.description,
  ogImage = '/og.png',
  hideFooter = false,
  footerForm = false,
} = Astro.props;

const pageTitle = title ? `${title} — ${site.nameKo} ${site.nameEn}` : `${site.nameKo} — ${site.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const ogImageUrl = new URL(ogImage, Astro.site ?? site.url).href;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={`${site.nameKo} ${site.nameEn}`} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content="ko_KR" />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <!-- Pretendard (dynamic subset — Hangul served per-glyph range) -->
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link
      rel="stylesheet"
      as="style"
      crossorigin
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />

    <script is:inline>
      // Mark JS early so the no-JS fallbacks in global.css never flash.
      document.documentElement.classList.add('js');
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">본문으로 건너뛰기</a>

    <div id="ajax-content-wrap">
      <Header />
      <main id="main">
        <slot />
      </main>
      {!hideFooter && <Footer form={footerForm} />}
    </div>

    <script>
      import '../scripts/motion.js';
    </script>

    <style is:global>
      .skip-link {
        position: absolute;
        left: -9999px;
        top: 0;
        z-index: 10000;
        padding: 12px 20px;
        background: #000;
        color: #fff;
        font-size: 0.875rem;
      }

      .skip-link:focus {
        left: 12px;
        top: 12px;
      }
    </style>
  </body>
</html>
