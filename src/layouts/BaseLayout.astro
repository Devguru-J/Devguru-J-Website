---
import '../styles/index.css';

import SiteHeader from '../components/global/SiteHeader.astro';
import FullscreenMenu from '../components/global/FullscreenMenu.astro';
import SiteFooter from '../components/global/SiteFooter.astro';
import { UI } from '../content/brand';
import { HTML_LANG, type Locale } from '../lib/i18n';
import { buildSeo } from '../lib/seo';

interface Props {
  locale: Locale;
  /** Locale-agnostic path, e.g. `/work/`. */
  path: string;
  title: string;
  description: string;
  image?: string;
  robots?: string;
  canonical?: string;
  singleRoute?: boolean;
  /** Header/footer chrome. Off for the 404 document. */
  chrome?: boolean;
  /** Opt out of the cross-document route wipe (404). */
  noRouteWipe?: boolean;
  bodyClass?: string;
}

const {
  locale,
  path,
  title,
  description,
  image,
  robots,
  canonical,
  singleRoute = false,
  chrome = true,
  noRouteWipe = false,
  bodyClass = '',
} = Astro.props;

const seo = buildSeo({
  path,
  locale,
  title,
  description,
  image,
  robots,
  canonical,
  singleRoute,
});
---

<!doctype html>
<html
  lang={HTML_LANG[locale]}
  data-route-wipe-opt-out={noRouteWipe ? 'true' : undefined}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={seo.robots} />
    <link rel="canonical" href={seo.canonical} />
    {
      seo.alternates.map((alt) => (
        <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
      ))
    }

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Memory" />
    <meta property="og:locale" content={locale === 'ko' ? 'ko_KR' : 'en_US'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={seo.canonical} />
    <meta property="og:image" content={seo.ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={seo.ogImage} />

    <link
      rel="preload"
      href="/assets/fonts/zalando-sans-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/assets/fonts/source-serif-pro-400-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="stylesheet" href="/assets/salient-fonts.css" />

    <meta name="theme-color" content="#090909" />
    <link rel="icon" href="/assets/favicon.png" />
    <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png" />

    <script>
      import '../motion/index.ts';
    </script>
  </head>

  <body class={bodyClass}>
    <a class="skip-link" href="#main">{UI.skip[locale]}</a>
    <div class="grain" aria-hidden="true"></div>

    {chrome && <SiteHeader locale={locale} path={path} />}

    <div data-menu-inert={chrome ? '' : undefined}>
      <main id="main">
        <slot />
      </main>
      {chrome && <SiteFooter locale={locale} />}
    </div>

    {chrome && <FullscreenMenu locale={locale} path={path} />}
  </body>
</html>
