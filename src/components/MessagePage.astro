---
import BaseLayout from '../layouts/BaseLayout.astro';
import { NEXT_PRODUCT_NOTICE } from '../content/brand';
import { localePath, type Locale } from '../lib/i18n';
import { absolute } from '../lib/seo';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const notice = NEXT_PRODUCT_NOTICE;
const workPath = localePath(locale, '/work/');
---

<BaseLayout
  locale={locale}
  path="/portfolio/next-product/"
  title={notice.title[locale]}
  description={notice.description[locale]}
  robots="noindex,follow"
  canonical={absolute(workPath)}
  singleRoute
>
  <section class="scene notice" data-surface="ink">
    <div class="frame grid notice__inner">
      <p class="c-1-3 eyebrow">{notice.eyebrow[locale]}</p>
      <h1 class="c-1-9 display notice__heading">
        {
          notice.heading[locale].map((line, i) => (
            <>
              {i > 0 && <br />}
              {line}
            </>
          ))
        }
      </h1>
      <div class="c-1-5 notice__body">
        <p class="body body--muted">{notice.body[locale]}</p>
        <a class="cta cta--line" href={workPath}>
          <span class="cta__label">
            <span>{notice.cta[locale]}</span>
            <span aria-hidden="true">{notice.cta[locale]}</span>
          </span>
          <svg class="cta__arrow" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M1 8h13M9 3l5 5-5 5" stroke="currentColor" stroke-width="1.25" />
          </svg>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .notice {
    min-height: 82dvh;
    display: flex;
    align-items: center;
    padding-top: var(--hero-top);
    padding-bottom: var(--gap-inner);
  }

  .notice__inner {
    width: 100%;
    row-gap: clamp(28px, 4vw, 56px);
  }

  .notice__heading {
    margin-block: clamp(20px, 3vw, 40px);
  }

  .notice__body {
    display: flex;
    flex-direction: column;
    gap: 24px;
    align-items: flex-start;
  }
</style>
