---
/**
 * 연락 양식.
 *
 * 구성은 도림사(dorimsa.com)의 의뢰 폼과 같은 뼈대입니다 —
 * 이름 · 회사/팀 · 연락 수단 · 예상 일정 · 필요한 작업 · 예산 · 내용 · 동의를
 * 한 칼럼으로 세우는 방식. 어휘만 이 브랜드 쪽으로 바꿨습니다.
 * 처음 보내는 사람이 무엇을 적어야 할지 알 수 있게 하는 것이 목적이라,
 * 빈 칸 하나에 "알아서 써 주세요" 하는 것보다 답이 빨라집니다.
 *
 * 스타일은 Salient Ascend 폼 사양 그대로 (css/src/ascend.css):
 *   background-color: transparent · border: 1px solid #ccc · padding: 16px
 *   font-size: 16px · box-shadow 없음 · :focus 는 테두리만 진해짐(#999)
 *   검은 배경(.span_12.light)에서는 테두리 rgba(255,255,255,0.6), 글자 흰색
 * 고정색 대신 currentColor 로 옮겨 배경 반전을 따라가게 했습니다.
 * 16px 는 취향이 아니라 사양입니다 — iOS 는 그보다 작으면 포커스 시 화면을 확대합니다.
 * 그래서 1rem 으로 적습니다. 기본 루트에서 정확히 16px 이고, 사용자가 글자를
 * 키우면 따라 커지기만 하므로 확대 유발선 아래로는 절대 내려가지 않습니다.
 *
 * ┌─────────────────────────────────────────────────────────────────────┐
 * │ 보내기를 누르면 /api/inquiry 로 갑니다 (functions/api/inquiry.ts).     │
 * │ 그쪽에서 Resend 로 메일 한 통이 나가고 jeff@bymemory.dev 로 도착합니다. │
 * │ 전송이 실패하면 적은 내용이 채워진 메일 앱 링크를 대신 내놓습니다 —      │
 * │ 서버가 죽어도 문의가 사라지지는 않게 합니다.                           │
 * └─────────────────────────────────────────────────────────────────────┘
 */
import { site } from '../data/site';
import { workTypes, budgets } from '../data/inquiry';

interface Props {
  class?: string;
}

const { class: className, ...rest } = Astro.props;
---

<form class:list={['contact-form', className]} novalidate {...rest}>
  <label class="contact-form__field">
    <span class="contact-form__label">이름 <em aria-hidden="true">*</em></span>
    <input type="text" name="name" autocomplete="name" required />
  </label>

  <label class="contact-form__field">
    <span class="contact-form__label">회사 또는 팀</span>
    <input type="text" name="org" autocomplete="organization" />
  </label>

  <label class="contact-form__field">
    <span class="contact-form__label">이메일 또는 연락 가능한 수단 <em aria-hidden="true">*</em></span>
    <input type="text" name="contact" autocomplete="email" required />
  </label>

  <label class="contact-form__field">
    <span class="contact-form__label">예상 일정</span>
    <input type="text" name="timeline" placeholder="예: 3월 중 시작 · 아직 미정" />
  </label>

  <label class="contact-form__field">
    <span class="contact-form__label">필요한 작업 <em aria-hidden="true">*</em></span>
    <div class="contact-form__select">
      <select name="type" required>
        <option value="" selected disabled>선택해 주세요</option>
        {workTypes.map((t) => <option value={t}>{t}</option>)}
      </select>
      <span class="contact-form__caret" aria-hidden="true"></span>
    </div>
  </label>

  <label class="contact-form__field">
    <span class="contact-form__label">예산 범위 <em aria-hidden="true">*</em></span>
    <div class="contact-form__select">
      <select name="budget" required>
        <option value="" selected disabled>선택해 주세요</option>
        {budgets.map((b) => <option value={b}>{b}</option>)}
      </select>
      <span class="contact-form__caret" aria-hidden="true"></span>
    </div>
  </label>

  <label class="contact-form__field">
    <span class="contact-form__label">내용 <em aria-hidden="true">*</em></span>
    <textarea
      name="message"
      rows="7"
      required
      placeholder="만들려는 것, 지금 겪고 있는 문제, 기존 방식에서 불편했던 점"></textarea>
  </label>

  {/* 스팸 봇용 미끼. 사람에게는 보이지 않고, 채워져 있으면 전송하지 않습니다. */}
  <div class="contact-form__trap" aria-hidden="true">
    <label>이 칸은 비워두세요<input type="text" name="company" tabindex="-1" autocomplete="off" /></label>
  </div>

  <div class="contact-form__consent-block">
    <label class="contact-form__consent">
      <input type="checkbox" name="consent" required />
      <span>
        문의에 답장하기 위해 이름 · 연락 수단 · 문의 내용을 받고 3년간 보관하는 데
        동의합니다. 동의하지 않아도 되지만, 그 경우 문의를 접수할 수 없습니다.
      </span>
    </label>
    <a class="contact-form__consent-more" href="/privacy/">개인정보처리방침 전문 보기</a>
  </div>

  <div class="contact-form__foot">
    <button type="submit" class="contact-form__submit">
      <span>보내기</span>
    </button>
    <p class="contact-form__note" data-form-note aria-live="polite">
      적어주신 연락 수단으로 답장드립니다.
    </p>
  </div>
</form>

<script define:vars={{ email: site.email }}>
  document.querySelectorAll('.contact-form').forEach((form) => {
    const note = form.querySelector('[data-form-note]');
    const submit = form.querySelector('.contact-form__submit');
    const label = submit.querySelector('span');
    const value = (name) => (form.elements[name]?.value ?? '').trim();

    /** 전송이 실패했을 때 내놓는 마지막 통로. 적은 내용이 그대로 채워집니다. */
    const mailtoFallback = () => {
      const lines = [
        ['이름', value('name')],
        ['회사 또는 팀', value('org')],
        ['연락 수단', value('contact')],
        ['예상 일정', value('timeline')],
        ['필요한 작업', value('type')],
        ['예산 범위', value('budget')],
      ]
        .filter(([, v]) => v)
        .map(([k, v]) => `${k}: ${v}`);

      const subject = `[기억] ${value('name')} 님의 문의`;
      const body = `${value('message')}\n\n---\n${lines.join('\n')}`;
      return `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    };

    const fail = () => {
      note.innerHTML = '';
      note.append('보내지 못했습니다. ');
      const link = document.createElement('a');
      link.href = mailtoFallback();
      link.textContent = '메일 앱으로 보내기';
      note.append(link);
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      // 미끼 칸이 채워졌으면 봇입니다. 조용히 무시합니다.
      if (form.elements.company.value) return;

      if (!form.checkValidity()) {
        note.textContent = '별표 표시된 칸과 동의를 확인해 주세요.';
        form.reportValidity();
        return;
      }

      submit.disabled = true;
      label.textContent = '보내는 중';
      note.textContent = '보내는 중입니다.';

      try {
        const response = await fetch('/api/inquiry', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            name: value('name'),
            org: value('org'),
            contact: value('contact'),
            timeline: value('timeline'),
            type: value('type'),
            budget: value('budget'),
            message: value('message'),
            consent: form.elements.consent.checked,
            company: form.elements.company.value,
          }),
        });

        const result = await response.json().catch(() => ({}));

        if (!response.ok || !result.ok) {
          fail();
          return;
        }

        // 메일이 실제로 나간 경우에만 셉니다. 버튼 클릭 수가 아니라 도착 수입니다.
        window.gtag?.('event', 'contact_submit', {
          work_type: value('type'),
          budget_range: value('budget'),
        });

        form.reset();
        note.textContent = '문의가 도착했습니다. 읽고 답장드리겠습니다.';
        label.textContent = '보냈습니다';
      } catch {
        fail();
      } finally {
        // 성공했을 때 다시 누를 이유는 없습니다. 실패했을 때만 되돌립니다.
        if (label.textContent === '보내는 중') {
          submit.disabled = false;
          label.textContent = '보내기';
        }
      }
    });
  });
</script>

<style>
  /* 도림사와 같은 한 칼럼. 처음부터 끝까지 순서대로 내려 읽습니다. */
  .contact-form {
    display: grid;
    gap: clamp(1.25rem, 2vw, 1.75rem);
  }

  .contact-form__field {
    display: grid;
    gap: 0.6rem;
  }

  .contact-form__label {
    font-size: var(--memory-fs-meta);
    letter-spacing: 0.13em;
    text-transform: uppercase;
    opacity: 0.7;
  }

  .contact-form__label em {
    font-style: normal;
    margin-left: 0.35em;
  }

  /* Salient Ascend: transparent bg · 1px border · 16px padding · 16px type */
  .contact-form input[type='text'],
  .contact-form textarea,
  .contact-form select {
    background-color: transparent;
    border: 1px solid;
    border-color: color-mix(in srgb, currentColor 25%, transparent);
    border-radius: 0;
    box-shadow: none;
    padding: 1rem;
    font-size: 1rem;
    line-height: 1.6;
    color: inherit;
    width: 100%;
    transition: border-color 0.45s var(--memory-ease-ui);
  }

  .contact-form textarea {
    resize: vertical;
    min-height: 10rem;
  }

  .contact-form input::placeholder,
  .contact-form textarea::placeholder {
    color: inherit;
    opacity: 0.3;
  }

  /* 원본은 #ccc → #999. 같은 방향으로 진해지게만 합니다. */
  .contact-form input[type='text']:focus,
  .contact-form textarea:focus,
  .contact-form select:focus {
    outline: none;
    border-color: color-mix(in srgb, currentColor 65%, transparent);
  }

  /* select 는 기본 화살표를 지우고 직접 그립니다 — OS 기본 화살표는
     검은 배경에서 보이지 않거나 브라우저마다 색이 제각각입니다. */
  .contact-form__select {
    position: relative;
  }

  .contact-form select {
    appearance: none;
    padding-right: 48px;
    cursor: pointer;
  }

  .contact-form select:invalid {
    opacity: 0.45;
  }

  .contact-form select option {
    /* 드롭다운 목록은 OS가 그리므로 대비를 직접 지정합니다. */
    background: #fff;
    color: #000;
  }

  .contact-form__caret {
    position: absolute;
    right: 18px;
    top: 50%;
    width: 8px;
    height: 8px;
    margin-top: -6px;
    border-right: 1px solid currentColor;
    border-bottom: 1px solid currentColor;
    transform: rotate(45deg);
    opacity: 0.45;
    pointer-events: none;
  }

  .contact-form__consent-block {
    display: grid;
    gap: 0.6rem;
    justify-items: start;
  }

  .contact-form__consent-more {
    font-size: var(--memory-fs-meta);
    opacity: 0.45;
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.3em;
    /* 체크박스 폭(18px)과 gap(0.75rem)만큼 들여 동의 문구와 줄을 맞춥니다. */
    margin-left: calc(18px + 0.75rem);
    transition: opacity 0.35s var(--memory-ease-ui);
  }

  .contact-form__consent-more:hover,
  .contact-form__consent-more:focus-visible {
    opacity: 0.8;
  }

  .contact-form__consent {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-size: 0.9375rem;
    line-height: 1.6;
    opacity: 0.7;
    cursor: pointer;
  }

  .contact-form__consent input {
    appearance: none;
    flex: none;
    width: 18px;
    height: 18px;
    margin-top: 0.25em;
    border: 1px solid;
    border-color: color-mix(in srgb, currentColor 45%, transparent);
    border-radius: 0;
    cursor: pointer;
    transition: background-color 0.35s var(--memory-ease-ui),
      border-color 0.35s var(--memory-ease-ui);
  }

  .contact-form__consent input:checked {
    background-color: currentColor;
    border-color: currentColor;
  }

  .contact-form__consent input:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  .contact-form__trap {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .contact-form__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
    margin-top: 0.5rem;
  }

  /* Salient Ascend submit: padding 16px, 납작한 테두리 버튼. */
  .contact-form__submit {
    padding: 16px 40px;
    background: transparent;
    border: 1px solid;
    border-color: color-mix(in srgb, currentColor 45%, transparent);
    border-radius: 0;
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    cursor: pointer;
    transition: border-color 0.45s var(--memory-ease-ui),
      background-color 0.45s var(--memory-ease-ui),
      color 0.45s var(--memory-ease-ui);
  }

  .contact-form__submit:hover,
  .contact-form__submit:focus-visible {
    border-color: currentColor;
    background-color: var(--nectar-page-text-color, #000);
    color: var(--nectar-page-background-color, #fff);
  }

  .contact-form__submit:disabled {
    cursor: default;
    opacity: 0.45;
  }

  .contact-form__submit:disabled:hover {
    background-color: transparent;
    color: inherit;
    border-color: color-mix(in srgb, currentColor 45%, transparent);
  }

  .contact-form__note {
    font-size: var(--memory-fs-meta);
    opacity: 0.4;
    margin: 0;
  }

  .contact-form__note :global(a) {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
</style>
