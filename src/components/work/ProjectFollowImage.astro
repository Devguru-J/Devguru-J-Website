---
import { INDEX_PROJECTS } from '../../content/projects';
import type { Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

{/* One reusable wrapper. It is hidden between rows rather than removed, and
    is decorative — every row states its own information without hover. */}
<div class="follow-preview" data-follow-preview data-preview-state="hidden" aria-hidden="true">
  <div class="follow-preview__inner">
    {
      INDEX_PROJECTS.map((project, i) => (
        <img
          class="follow-preview__img"
          data-follow-slug={project.slug}
          data-active={i === 0 ? 'true' : 'false'}
          src={project.media.preview.src}
          width={project.media.preview.width}
          height={project.media.preview.height}
          alt=""
          loading="lazy"
          decoding="async"
        />
      ))
    }
  </div>
</div>

<style>
  .follow-preview {
    background: var(--ink-950);
  }

  .follow-preview__img {
    filter: grayscale(1) contrast(1.04);
  }

  /* The controller never loads outside this gate; the CSS mirrors it so a
     stale wrapper can never appear on touch or at tablet width. */
  @media (max-width: 999px), (hover: none), (pointer: coarse) {
    .follow-preview {
      display: none;
    }
  }
</style>
