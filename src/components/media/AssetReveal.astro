---
/**
 * Salient asset-reveal wrapper.
 *
 * The class names, the nesting and even the source's own misspelling of
 * `img-with-aniamtion-wrap` are kept so the parity manifest maps directly onto
 * the theme's `ro-reveal-from-bottom` markup:
 *
 *   .img-with-aniamtion-wrap > .inner > .hover-wrap > .hover-wrap-inner > img
 *
 * The outer layer translates, the inner layer counter-rotates and carries the
 * only visible opacity change, and the media counter-rotates back.
 * Direction is fixed to from-bottom on every route that uses it (05 §4 D).
 */
---

<div class="img-with-aniamtion-wrap" data-animation="ro-reveal-from-bottom">
  <div class="inner">
    <div class="hover-wrap">
      <div class="hover-wrap-inner">
        <slot />
      </div>
    </div>
  </div>
</div>

<style is:global>
  .img-with-aniamtion-wrap > .inner > .hover-wrap,
  .img-with-aniamtion-wrap > .inner > .hover-wrap > .hover-wrap-inner {
    display: block;
  }

  .img-with-aniamtion-wrap img {
    display: block;
    width: 100%;
  }
</style>
