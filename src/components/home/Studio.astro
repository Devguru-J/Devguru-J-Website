---
import { STUDIO } from '../../content/brand';
import type { Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<section
  class="studio scene"
  data-surface="paper"
  id={STUDIO.id}
  aria-labelledby="studio-heading"
>
  <div class="frame">
    <figure class="studio__media">
      <div class="media media--muted studio__frame">
        <img
          src={STUDIO.media.src}
          width={STUDIO.media.width}
          height={STUDIO.media.height}
          alt={STUDIO.media.alt[locale]}
          loading="lazy"
          decoding="async"
        />
      </div>
      <figcaption class="caption">{STUDIO.media.caption[locale]}</figcaption>
    </figure>

    <div class="grid studio__text">
      <div class="c-1-7">
        <p class="eyebrow studio__eyebrow">{STUDIO.eyebrow[locale]}</p>
        <h2 id="studio-heading" class="display">
          {
            STUDIO.heading[locale].map((line, i) => (
              <>
                {i > 0 && <br />}
                {line}
              </>
            ))
          }
        </h2>
      </div>
      <div class="c-9-12 studio__body">
        <p class="body">{STUDIO.body[locale]}</p>
        <p class="body body--muted">{STUDIO.support[locale]}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .studio__frame {
    aspect-ratio: 16 / 7;
    border-radius: var(--radius-media);
  }

  .studio__text {
    margin-top: clamp(96px, 11vw, 160px);
    row-gap: var(--gap-md);
    align-items: end;
  }

  .studio__eyebrow {
    margin-bottom: clamp(20px, 2.4vw, 36px);
  }

  .studio__body {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  @media (max-width: 767px) {
    .studio__frame {
      aspect-ratio: 4 / 5;
    }

    .studio__text {
      margin-top: 56px;
    }
  }
</style>
