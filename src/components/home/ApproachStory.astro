---
import { APPROACH } from '../../content/brand';
import type { Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const steps = APPROACH.steps;
---

<section
  class="approach scene"
  data-surface="paper"
  id={APPROACH.id}
  aria-labelledby="approach-heading"
  data-sticky-story
>
  <div class="frame">
    <div class="grid approach__head">
      <p class="c-1-3 eyebrow">{APPROACH.eyebrow[locale]}</p>
      <h2 id="approach-heading" class="c-1-6 display approach__heading">
        {APPROACH.heading[locale]}
      </h2>
      <p class="c-9-12 body body--muted approach__intro">{APPROACH.intro[locale]}</p>
    </div>

    <div class="grid approach__body">
      <div class="c-1-5 approach__media-col">
        <div class="approach__sticky" data-sticky-media>
          <div class="media media--16-10 approach__frame">
            {
              steps.map((step, i) => (
                <div
                  class="sticky-media__item approach__item"
                  data-sticky-item
                  data-active={i === 0 ? 'true' : 'false'}
                >
                  <img
                    src={step.media.src}
                    width={step.media.width}
                    height={step.media.height}
                    alt={step.media.alt[locale]}
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              ))
            }
          </div>
        </div>
      </div>

      <ol class="c-7-12 approach__steps">
        {
          steps.map((step, i) => (
            <li class="approach__step" data-sticky-step data-active={i === 0 ? 'true' : 'false'}>
              <figure class="approach__inline media media--16-10">
                <img
                  src={step.media.src}
                  width={step.media.width}
                  height={step.media.height}
                  alt={step.media.alt[locale]}
                  loading="lazy"
                  decoding="async"
                />
              </figure>
              <p class="meta approach__number">{step.number}</p>
              <h3 class="h3 approach__title">{step.title[locale]}</h3>
              <p class="body body--muted approach__text">{step.body[locale]}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .approach__head {
    row-gap: var(--gap-md);
    margin-bottom: var(--gap-inner);
  }

  .approach__intro {
    align-self: end;
  }

  .approach__sticky {
    position: sticky;
    /* Written by the sticky controller from the source's own formula:
       (viewportHeight − renderedMediaHeight) / 2 + headerSpace / 2 */
    top: var(--nectar-sticky-media-sections-vert-y, calc(var(--header-h) + 40px));
  }

  .approach__frame {
    position: relative;
    border: 1px solid var(--hairline);
    border-radius: 2px;
  }

  /* One frame ratio for the whole sequence. The five approved screenshots are
     a mix of 16:10 and 4:5 sources, so they are cropped to a common band
     rather than letterboxed into a mat that would read as empty space. */
  .approach__item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 50%;
    filter: grayscale(1) contrast(1.02);
  }

  .approach__steps {
    display: flex;
    flex-direction: column;
  }

  .approach__step {
    display: grid;
    grid-template-columns: minmax(56px, 2fr) 9fr;
    column-gap: var(--gutter);
    align-content: center;
    min-height: 58dvh;
    padding-block: clamp(28px, 4vw, 48px);
    border-top: 1px solid var(--hairline);
  }

  .approach__step:last-child {
    border-bottom: 1px solid var(--hairline);
  }

  .approach__number {
    grid-column: 1;
    color: var(--fg-muted);
    padding-top: 0.5em;
  }

  .approach__title {
    grid-column: 2;
    margin-bottom: 14px;
  }

  .approach__text {
    grid-column: 2;
    max-width: 46ch;
  }

  /* Inactive text stays readable — dimmed by weight and muted token, never by
     an opacity value that would fail contrast. */
  .approach__step[data-active='false'] .approach__title {
    color: var(--fg-muted);
    transition: color var(--sticky-fade) ease;
  }

  .approach__step[data-active='true'] .approach__title {
    color: var(--fg);
    transition: color var(--sticky-fade) ease;
  }

  .approach__inline {
    display: none;
  }

  /* Below the activation breakpoint the sticky column is removed entirely and
     each media sits directly in front of the text it belongs to. */
  @media (max-width: 999px) {
    .approach__media-col {
      display: none;
    }

    .approach__step {
      grid-template-columns: minmax(48px, 1fr) 7fr;
      min-height: 0;
      padding-block: clamp(24px, 5vw, 40px);
    }

    .approach__inline {
      display: block;
      grid-column: 1 / -1;
      margin-bottom: 24px;
      border: 1px solid var(--hairline);
      border-radius: 2px;
    }

    .approach__inline img {
      object-position: 50% 50%;
      filter: grayscale(1) contrast(1.02);
    }
  }

  @media (max-width: 767px) {
    .approach__step {
      grid-template-columns: 1fr;
      row-gap: 8px;
    }

    .approach__number,
    .approach__title,
    .approach__text {
      grid-column: 1;
    }

    .approach__number {
      padding-top: 0;
    }
  }
</style>
