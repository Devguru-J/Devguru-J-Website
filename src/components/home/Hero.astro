---
import { HERO } from '../../content/brand';
import { localePath, type Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

/* Salient splits the title on literal spaces, so the brand line is fixed at
   four masks: Built / to / be / remembered. The spans are generated here at
   build time rather than by runtime innerHTML, so the sentence is complete in
   the DOM whether or not the controller ever runs. */
const words = HERO.line.split(' ');
---

<section class="hero scene scene--ink" data-surface="ink" data-hero>
  <div class="hero__plane" aria-hidden="true">
    <div class="hero__plane-inner hero-plane__inner">
      <img
        src="/assets/mockups/salient-saas-phone.png"
        width="652"
        height="961"
        alt=""
        loading="eager"
        decoding="async"
      />
    </div>
  </div>

  <div class="frame grid hero__inner">
    <p class="c-1-3 eyebrow hero-support hero__eyebrow">
      {HERO.eyebrow[locale]}
    </p>

    <h1 class="c-1-12 brand-line hero__line">
      {
        words.map((word, i) => (
          <>
            <span class="hero-word"><span>{word}</span></span>
            {i < words.length - 1 && ' '}
          </>
        ))
      }
    </h1>

    <div class="c-2-9 hero__statement hero-support">
      <p class="display-kr hero__statement-text">
        {
          HERO.statement[locale].map((line, i) => (
            <>
              {i > 0 && <br />}
              {line}
            </>
          ))
        }
      </p>
    </div>

    <div class="c-10-12 hero__aside hero-support">
      <p class="body body--muted">{HERO.body[locale]}</p>
      <div class="cta-group">
        <a class="cta cta--pill" href={localePath(locale, '/work/')}>
          <span class="cta__label">
            <span>{HERO.primaryCta[locale]}</span>
            <span aria-hidden="true">{HERO.primaryCta[locale]}</span>
          </span>
          <svg class="cta__arrow" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M1 8h13M9 3l5 5-5 5" stroke="currentColor" stroke-width="1.25" />
          </svg>
        </a>
        <a class="cta cta--line" href={`${localePath(locale, '/')}#approach`}>
          <span class="cta__label">
            <span>{HERO.secondaryCta[locale]}</span>
            <span aria-hidden="true">{HERO.secondaryCta[locale]}</span>
          </span>
        </a>
      </div>
    </div>

    <p class="c-1-3 meta meta--muted hero__hint hero-support">
      {HERO.scrollHint[locale]}
    </p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100dvh;
    display: flex;
    align-items: stretch;
    padding-top: var(--hero-top);
    padding-bottom: clamp(44px, 6vw, 96px);
    overflow: hidden;
  }

  .hero__inner {
    width: 100%;
    align-content: space-between;
    row-gap: clamp(40px, 6vw, 96px);
  }

  /* One restrained media plane. It sits behind the type as a surface, not as a
     product claim: cropped to its lower body so the demo's stock portrait is
     out of frame, desaturated into the ink palette, and faded low enough that
     the hero keeps a single dominant object. */
  .hero__plane {
    position: absolute;
    right: -7%;
    bottom: -12%;
    width: min(30vw, 400px);
    pointer-events: none;
    z-index: 0;
    mask-image: linear-gradient(205deg, transparent 2%, #000 48%, transparent 99%);
  }

  /* The device reads as a silhouette in the ink, never as legible content:
     desaturated, dropped to a fraction of the surrounding contrast and softened
     just enough that the demo's own copy cannot be read behind the headline. */
  .hero__plane-inner {
    filter: grayscale(1) contrast(0.5) brightness(0.55) blur(1.4px);
    opacity: 0.17;
    transform-origin: 60% 100%;
  }

  .hero__inner > * {
    position: relative;
    z-index: 1;
  }

  .hero__line {
    margin-block: clamp(24px, 3vw, 48px) 0;
  }

  .hero__eyebrow {
    align-self: start;
  }

  .hero__statement {
    align-self: end;
  }

  /* The English brand line stays the largest element; the Korean statement is
     sized to hold its two authored lines without an orphan at 1440. */
  .hero__statement-text {
    font-size: clamp(38px, 5vw, 76px);
  }

  .hero__aside {
    align-self: end;
    display: flex;
    flex-direction: column;
    gap: var(--gap-md);
  }

  .hero__hint {
    grid-row: 4;
    align-self: end;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .hero__hint::after {
    content: '';
    width: 1px;
    height: 40px;
    background: currentColor;
    opacity: 0.4;
  }

  @media (max-width: 999px) {
    .hero__plane {
      width: min(38vw, 300px);
      opacity: 0.7;
    }
  }

  @media (max-width: 767px) {
    .hero {
      padding-top: calc(var(--header-h) + 72px);
    }

    .hero__inner {
      row-gap: 40px;
    }

    .hero__line {
      margin-top: 20px;
    }

    .hero__plane {
      right: -14%;
      bottom: auto;
      top: 8%;
      width: 52vw;
      opacity: 0.4;
    }

    .hero__hint {
      display: none;
    }
  }
</style>
