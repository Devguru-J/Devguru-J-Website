---
import AssetReveal from '../media/AssetReveal.astro';
import { SELECTED_WORK } from '../../content/brand';
import { FEATURED_PROJECTS } from '../../content/projects';
import { localePath, type Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const projects = FEATURED_PROJECTS;
---

<section class="work scene" data-surface="paper" aria-labelledby="selected-work">
  <div class="frame">
    <div class="grid work__head">
      <h2 id="selected-work" class="c-1-7 display">
        {
          SELECTED_WORK.heading[locale].map((line, i) => (
            <>
              {i > 0 && <br />}
              {line}
            </>
          ))
        }
      </h2>
      <div class="c-9-12 work__head-aside">
        <p class="eyebrow">{SELECTED_WORK.eyebrow[locale]}</p>
        <p class="body body--muted">{SELECTED_WORK.intro[locale]}</p>
      </div>
    </div>

    <ol class="work__list">
      {
        projects.map((project, index) => {
          const href = localePath(locale, `/portfolio/${project.slug}/`);
          const copy = project.copy[locale];
          const flipped = index % 2 === 1;
          return (
            <li class:list={['work__item', flipped && 'work__item--flipped']}>
              <a class="work__media-link" href={href} tabindex="-1" aria-hidden="true">
                {index === 0 ? (
                  <AssetReveal>
                    <figure class="media media--16-10 media--muted work__media">
                      <img
                        src={project.media.hero.src}
                        width={project.media.hero.width}
                        height={project.media.hero.height}
                        alt=""
                        loading="lazy"
                        decoding="async"
                      />
                    </figure>
                  </AssetReveal>
                ) : (
                  <figure class="media media--16-9 media--muted work__media">
                    <img
                      src={project.media.hero.src}
                      width={project.media.hero.width}
                      height={project.media.hero.height}
                      alt=""
                      loading="lazy"
                      decoding="async"
                    />
                  </figure>
                )}
              </a>

              <div class="work__body">
                <p class="meta meta--muted work__index">
                  {String(index + 1).padStart(2, '0')} — {project.type[locale]}
                </p>
                <h3 class="title-project work__title">
                  <a href={href}>{project.title}</a>
                </h3>
                <p class="body body--muted work__summary">{copy.summary}</p>
                <p class="meta meta--muted">{project.platform[locale]}</p>
                <a class="cta cta--line work__cta" href={href} tabindex="-1" aria-hidden="true">
                  <span class="cta__label">
                    <span>{SELECTED_WORK.projectCta[locale]}</span>
                    <span>{SELECTED_WORK.projectCta[locale]}</span>
                  </span>
                  <svg class="cta__arrow" viewBox="0 0 16 16" fill="none">
                    <path d="M1 8h13M9 3l5 5-5 5" stroke="currentColor" stroke-width="1.25" />
                  </svg>
                </a>
              </div>
            </li>
          );
        })
      }
    </ol>

    <div class="work__all">
      <a class="cta cta--line" href={localePath(locale, '/work/')}>
        <span class="cta__label">
          <span>{SELECTED_WORK.allCta[locale]}</span>
          <span aria-hidden="true">{SELECTED_WORK.allCta[locale]}</span>
        </span>
        <svg class="cta__arrow" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M1 8h13M9 3l5 5-5 5" stroke="currentColor" stroke-width="1.25" />
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .work__head {
    row-gap: var(--gap-md);
    margin-bottom: var(--gap-inner);
  }

  .work__head-aside {
    display: flex;
    flex-direction: column;
    gap: 20px;
    align-self: end;
  }

  .work__list {
    display: flex;
    flex-direction: column;
    gap: var(--gap-project);
  }

  /* Alternating asymmetry: 9|3 then 4|8. Never a repeated card shell, and the
     real media is visible before any hover. */
  .work__item {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    row-gap: var(--gap-md);
    align-items: end;
  }

  .work__media-link {
    grid-column: 1 / 10;
  }

  .work__body {
    grid-column: 10 / 13;
  }

  .work__item--flipped .work__media-link {
    grid-column: 5 / 13;
    grid-row: 1;
  }

  .work__item--flipped .work__body {
    grid-column: 1 / 5;
    grid-row: 1;
  }

  .work__media {
    border-radius: var(--radius-media);
  }

  .work__body {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .work__index {
    padding-bottom: 14px;
    border-bottom: 1px solid var(--hairline);
  }

  .work__title a::after {
    /* The whole card is clickable, but only the title is the semantic link. */
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
  }

  .work__item {
    position: relative;
  }

  .work__summary {
    max-width: 34ch;
  }

  .work__all {
    margin-top: var(--gap-inner);
    padding-top: var(--gap-md);
    border-top: 1px solid var(--hairline);
  }

  @media (max-width: 999px) {
    .work__media-link,
    .work__item--flipped .work__media-link {
      grid-column: 1 / 13;
      grid-row: 1;
    }

    .work__body,
    .work__item--flipped .work__body {
      grid-column: 1 / 13;
      grid-row: 2;
    }

    .work__summary {
      max-width: 52ch;
    }
  }
</style>
