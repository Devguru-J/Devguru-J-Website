---
import SplitHeading from './SplitHeading.astro';
import Reveal from './Reveal.astro';
import ContactForm from './ContactForm.astro';
import { site } from '../data/site';

interface Props {
  /**
   * 연락 양식을 함께 보일지. 홈에서만 켭니다 —
   * 모든 페이지 하단에 폼이 반복되면 조용한 마무리가 아니라 영업 화면이 됩니다.
   */
  form?: boolean;
}

const { form = false } = Astro.props;
const year = new Date().getFullYear();
---

<footer
  id="footer"
  class="section"
  data-color-change-section-bg-color="#000000"
  data-color-change-section-text-color="#ffffff"
>
  <div class="container">
    <p class="eyebrow"><span class="eyebrow__index">—</span><span>연락</span></p>

    <SplitHeading tag="h2" class="footer__title">
      만들 이유가 분명한 일이라면,<br />이야기를 듣고 싶습니다.
    </SplitHeading>

    {/* 푸터에 메일 주소를 크게 적지 않습니다 — 연락은 양식 하나로 받습니다.
        주소가 필요한 사람을 위해 연락 페이지에는 그대로 남겨 두었습니다. */}
    {
      !form && (
        <Reveal animation="fade-in-from-bottom" delay={120} class="footer__link">
          <a href="/contact/">양식으로 보내기</a>
        </Reveal>
      )
    }

    {
      form && (
        <Reveal animation="slight-fade-in-from-bottom" delay={200} class="footer__form">
          <ContactForm />
        </Reveal>
      )
    }

    <Reveal animation="fade-in" delay={220} class="footer__meta">
      <hr class="rule" />
      <div class="footer__meta-grid">
        <p>© {year} {site.nameKo} ({site.nameEn})</p>
        <p class="footer__tagline">{site.tagline}</p>
        <p class="footer__legal">
          <a href="/MonkeyFlash/privacy/">Monkey Flash 개인정보처리방침</a>
          <a href="/MonkeyFlash/support/">지원</a>
        </p>
      </div>
    </Reveal>
  </div>
</footer>

<style>
  #footer {
    padding-block: clamp(120px, 14vw, 220px) clamp(40px, 4vw, 64px);
  }

  .footer__title {
    margin-top: clamp(32px, 4vw, 56px);
    font-size: var(--memory-fs-h2);
    max-width: 18ch;
  }

  /* 주소가 있던 자리. 이제 연락 페이지로 가는 한 줄만 둡니다. */
  .footer__link {
    margin-top: clamp(48px, 6vw, 88px);
    font-size: var(--memory-fs-meta);
    letter-spacing: 0.02em;
    opacity: 0.45;
  }

  .footer__link a {
    border-bottom: 1px solid transparent;
    transition: border-color 0.45s var(--memory-ease-ui);
  }

  .footer__link a:hover,
  .footer__link a:focus-visible {
    border-bottom-color: currentColor;
  }

  .footer__form {
    margin-top: clamp(3rem, 5vw, 4.5rem);
    max-width: 46rem;
  }

  /* 주소 없이 제목 바로 아래 오는 경우, 주소가 만들던 만큼의 사이를 둡니다. */
  .footer__title + .footer__form {
    margin-top: clamp(48px, 6vw, 88px);
  }

  .footer__meta {
    margin-top: clamp(96px, 14vw, 200px);
  }

  /* 폼이 있으면 저작권 줄까지의 거리를 줄입니다 — 둘 다 크게 주면 빈 화면이 됩니다. */
  .footer__form + .footer__meta {
    margin-top: clamp(64px, 9vw, 128px);
  }

  .footer__meta-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-top: 1.75rem;
    font-size: var(--memory-fs-meta);
    letter-spacing: 0.01em;
    opacity: 0.5;
  }

  .footer__tagline {
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* App Store 에 등록된 법적 페이지 — 항상 도달 가능해야 한다. */
  .footer__legal {
    display: flex;
    gap: 1.5rem;
  }

  .footer__legal a {
    border-bottom: 1px solid transparent;
    transition: border-color 0.4s var(--nectar-cubic-bezier-out);
  }

  .footer__legal a:hover,
  .footer__legal a:focus-visible {
    border-bottom-color: currentColor;
  }

  @media (max-width: 720px) {
    .footer__meta-grid {
      flex-direction: column;
    }
  }
</style>
