---
import { BRAND, CONTACT, UI } from '../../content/brand';
import { FOOTER_DIRECTORY } from '../../content/navigation';
import { localePath, type Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const year = new Date().getFullYear();

const href = (item: (typeof FOOTER_DIRECTORY)[number]) =>
  item.anchor
    ? `${localePath(locale, item.path)}#${item.anchor}`
    : localePath(locale, item.path);
---

<footer class="footer scene scene--ink" data-surface="ink">
  <div class="frame grid footer__inner">
    <div class="c-1-4 footer__brand">
      <p class="footer__wordmark">{BRAND.wordmark}</p>
      <p class="meta meta--muted">{BRAND.descriptor[locale]}</p>
    </div>

    <nav class="c-6-8 footer__col" aria-label={UI.directory[locale]}>
      <p class="meta meta--muted footer__label">{UI.directory[locale]}</p>
      <ul>
        {
          FOOTER_DIRECTORY.map((item) => (
            <li>
              <a href={href(item)}>{item.label[locale]}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="c-9-10 footer__col">
      <p class="meta meta--muted footer__label">{UI.elsewhere[locale]}</p>
      <ul>
        <li>
          <a href={CONTACT.appStore} target="_blank" rel="noopener">App Store</a>
        </li>
        <li>
          <a href={CONTACT.github} target="_blank" rel="noopener">GitHub</a>
        </li>
        <li>
          <a href="https://kbinc.kr" target="_blank" rel="noopener">kbinc.kr</a>
        </li>
      </ul>
    </div>

    <div class="c-11-12 footer__col">
      <p class="meta meta--muted footer__label">{UI.legal[locale]}</p>
      <ul>
        <li><a href="/MonkeyFlash/privacy/">{UI.privacy[locale]}</a></li>
        <li><a href="/MonkeyFlash/support/">{UI.support[locale]}</a></li>
      </ul>
    </div>

    <p class="c-1-12 meta meta--muted footer__base">
      © {year} {UI.rights[locale]}
    </p>
  </div>
</footer>

<style>
  .footer {
    padding-top: var(--gap-inner);
    padding-bottom: clamp(32px, 4vw, 56px);
  }

  .footer__inner {
    row-gap: var(--gap-lg);
    align-items: start;
  }

  .footer__wordmark {
    font-family: var(--font-serif);
    font-size: clamp(30px, 2.6vw, 40px);
    line-height: 1;
    letter-spacing: -0.03em;
    margin-bottom: 10px;
  }

  .footer__label {
    margin-bottom: 16px;
  }

  .footer__col ul {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .footer__col a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    font-size: 15px;
    opacity: 0.86;
    border-bottom: 1px solid transparent;
    transition:
      opacity var(--ui-fast) var(--ui-ease),
      border-color var(--ui-fast) var(--ui-ease);
  }

  .footer__col a:hover,
  .footer__col a:focus-visible {
    opacity: 1;
    border-bottom-color: currentColor;
  }

  .footer__base {
    padding-top: 28px;
    margin-top: clamp(40px, 6vw, 88px);
    border-top: 1px solid var(--hairline);
  }

  @media (max-width: 999px) {
    .footer__inner > .c-6-8 {
      grid-column: 1 / 4;
    }
    .footer__inner > .c-9-10 {
      grid-column: 4 / 7;
    }
    .footer__inner > .c-11-12 {
      grid-column: 7 / 9;
    }
  }

  @media (max-width: 767px) {
    .footer__brand {
      margin-bottom: 8px;
    }
  }
</style>
