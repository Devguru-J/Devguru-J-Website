---
import { UI } from '../../content/brand';
import { alternatePath, localePath, type Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
  path: string;
  /** Bilingual single routes (privacy/support) toggle in place. */
  inPlace?: boolean;
}

const { locale, path, inPlace = false } = Astro.props;

const options: { code: Locale; label: string }[] = [
  { code: 'ko', label: 'KO' },
  { code: 'en', label: 'EN' },
];
---

<div class="lang" role="group" aria-label={UI.languageGroup[locale]}>
  {
    options.map((option, i) => (
      <>
        {i > 0 && <span class="lang__sep" aria-hidden="true">/</span>}
        <a
          class="lang__item"
          href={
            option.code === locale
              ? localePath(locale, path)
              : alternatePath(locale, path)
          }
          hreflang={option.code}
          data-lang-set={option.code}
          data-lang-in-place={inPlace ? 'true' : undefined}
          aria-current={option.code === locale ? 'true' : undefined}
        >
          {option.label}
        </a>
      </>
    ))
  }
</div>

<script>
  // The manual choice always outranks the geo decision made by the Pages
  // Function at "/", so the toggle writes the cookie the Function reads.
  document.querySelectorAll<HTMLAnchorElement>('[data-lang-set]').forEach((el) => {
    el.addEventListener('click', () => {
      document.cookie = `lang=${el.dataset.langSet}; path=/; max-age=31536000; samesite=lax`;
    });
  });
</script>

<style>
  .lang {
    display: flex;
    align-items: center;
    gap: 7px;
    font-family: var(--font-mono);
    font-size: var(--t-meta);
    letter-spacing: 0.1em;
  }

  .lang__item {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    opacity: 0.5;
    transition: opacity var(--ui-fast) var(--ui-ease);
  }

  .lang__item:hover,
  .lang__item:focus-visible {
    opacity: 1;
  }

  .lang__item[aria-current='true'] {
    opacity: 1;
  }

  .lang__sep {
    opacity: 0.3;
  }
</style>
