---
import LanguageSwitch from './LanguageSwitch.astro';
import { BRAND, UI } from '../../content/brand';
import { PRIMARY_NAV } from '../../content/navigation';
import { localePath, type Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
  path: string;
}

const { locale, path } = Astro.props;

const href = (item: (typeof PRIMARY_NAV)[number]) =>
  item.anchor
    ? `${localePath(locale, item.path)}#${item.anchor}`
    : localePath(locale, item.path);

const isCurrent = (item: (typeof PRIMARY_NAV)[number]) =>
  !item.anchor && item.path === path;
---

<header class="header">
  <div class="frame frame--visual header__inner">
    <a class="header__brand" href={localePath(locale, '/')}>
      <span class="header__wordmark">{BRAND.wordmark}</span>
      <span class="header__descriptor meta">{BRAND.descriptor[locale]}</span>
    </a>

    <nav class="header__nav" aria-label={locale === 'ko' ? '주요 메뉴' : 'Primary'}>
      <ul class="header__list">
        {
          PRIMARY_NAV.map((item) => (
            <li>
              <a
                class="header__link"
                href={href(item)}
                aria-current={isCurrent(item) ? 'page' : undefined}
              >
                {item.label[locale]}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header__end">
      <LanguageSwitch locale={locale} path={path} />
      <button
        class="header__trigger"
        type="button"
        data-menu-trigger
        aria-expanded="false"
        aria-controls="site-menu"
      >
        <span class="header__trigger-label meta">{UI.menu[locale]}</span>
        <span class="header__bars" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>
  </div>
</header>

<style>
  /* The header shares the visual frame's baseline rather than sitting on an
     edge-to-edge bar. `difference` blending is what keeps the wordmark and the
     links legible the instant an ink section scrolls under a paper one. */
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: var(--z-header);
    height: var(--header-h);
    display: flex;
    align-items: center;
    color: var(--paper-50);
    mix-blend-mode: difference;
    pointer-events: none;
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--gap-md);
    width: 100%;
  }

  .header__inner > * {
    pointer-events: auto;
  }

  .header__brand {
    display: flex;
    align-items: baseline;
    gap: 14px;
    min-height: 44px;
  }

  .header__wordmark {
    font-family: var(--font-serif);
    font-size: 25px;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .header__descriptor {
    opacity: 0.62;
  }

  .header__list {
    display: flex;
    align-items: center;
    gap: clamp(20px, 2.4vw, 40px);
  }

  .header__link {
    position: relative;
    display: inline-block;
    padding: 12px 0;
    font-size: 15px;
    font-weight: 500;
    letter-spacing: -0.01em;
    opacity: 0.78;
    transition: opacity var(--ui-fast) var(--ui-ease);
  }

  .header__link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 6px;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--ui-medium) var(--ui-ease);
  }

  .header__link:hover,
  .header__link:focus-visible,
  .header__link[aria-current='page'] {
    opacity: 1;
  }

  .header__link:hover::after,
  .header__link:focus-visible::after,
  .header__link[aria-current='page']::after {
    transform: scaleX(1);
  }

  .header__end {
    display: flex;
    align-items: center;
    gap: clamp(16px, 1.6vw, 28px);
  }

  .header__trigger {
    display: none;
    align-items: center;
    gap: 12px;
    min-height: 44px;
  }

  /* Two precise lines — not a three-bar hamburger. */
  .header__bars {
    display: grid;
    gap: 5px;
    width: 22px;
  }

  .header__bars i {
    display: block;
    height: 1px;
    background: currentColor;
  }

  .header__bars i:last-child {
    width: 14px;
    margin-left: auto;
  }

  @media (max-width: 1199px) {
    .header__descriptor {
      display: none;
    }
  }

  @media (max-width: 999px) {
    .header__nav {
      display: none;
    }

    .header__trigger {
      display: flex;
    }
  }
</style>
