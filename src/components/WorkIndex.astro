---
import AssetReveal from './media/AssetReveal.astro';
import ProjectFollowImage from './work/ProjectFollowImage.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { META, UI, WORK_INDEX } from '../content/brand';
import { INDEX_PROJECTS } from '../content/projects';
import { localePath, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const projects = INDEX_PROJECTS;
const lead = projects[0];
---

<BaseLayout
  locale={locale}
  path="/work/"
  title={META.work.title[locale]}
  description={META.work.description[locale]}
>
  <section class="scene work-intro" data-surface="ink">
    <div class="frame grid work-intro__inner">
      <p class="c-1-3 eyebrow">{WORK_INDEX.eyebrow[locale]}</p>
      <p class="c-10-12 meta meta--muted work-intro__count">
        {UI.projectCount[locale]} · {String(projects.length).padStart(2, '0')}
      </p>
      <h1 class="c-1-9 display work-intro__heading">
        {
          WORK_INDEX.heading[locale].map((line, i) => (
            <>
              {i > 0 && <br />}
              {line}
            </>
          ))
        }
      </h1>
      <p class="c-9-12 body body--muted work-intro__body">{WORK_INDEX.intro[locale]}</p>
    </div>
  </section>

  {/* One project image is visible before any hover, exactly as the IA requires. */}
  <div class="scene work-lead" data-surface="ink">
    <div class="frame frame--visual">
      <AssetReveal>
        <figure class="media media--16-10 media--muted work-lead__media">
          <img
            src={lead.media.hero.src}
            width={lead.media.hero.width}
            height={lead.media.hero.height}
            alt={lead.media.hero.alt[locale]}
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </figure>
      </AssetReveal>
    </div>
  </div>

  <section
    class="scene work-rows"
    data-surface="ink"
    data-project-index
    aria-label={WORK_INDEX.eyebrow[locale]}
  >
    <ProjectFollowImage locale={locale} />

    <ol class="frame work-rows__list">
      {
        projects.map((project, index) => {
          const href = localePath(locale, `/portfolio/${project.slug}/`);
          const copy = project.copy[locale];
          return (
            <li class="work-row" data-project-row={project.slug}>
              <a class="work-row__link" href={href}>
                <span class="meta meta--muted work-row__index">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <span class="title-project work-row__title">{project.title}</span>
                <span class="meta meta--muted work-row__type">{project.type[locale]}</span>
                <span class="meta meta--muted work-row__platform">
                  {project.platform[locale]}
                </span>
                <svg
                  class="work-row__arrow"
                  viewBox="0 0 16 16"
                  fill="none"
                  aria-hidden="true"
                >
                  <path d="M1 8h13M9 3l5 5-5 5" stroke="currentColor" stroke-width="1.25" />
                </svg>
              </a>

              <div class="work-row__detail">
                <p class="body body--muted work-row__summary">{copy.summary}</p>
                <figure class="media media--16-10 media--muted work-row__media">
                  <img
                    src={project.media.hero.src}
                    width={project.media.hero.width}
                    height={project.media.hero.height}
                    alt={project.media.hero.alt[locale]}
                    loading="lazy"
                    decoding="async"
                  />
                </figure>
              </div>
            </li>
          );
        })
      }
    </ol>
  </section>
</BaseLayout>

<style>
  .work-intro {
    min-height: 68dvh;
    display: flex;
    align-items: flex-end;
    padding-top: var(--hero-top);
    padding-bottom: var(--gap-inner);
  }

  .work-intro__inner {
    width: 100%;
    row-gap: clamp(28px, 4vw, 56px);
  }

  .work-intro__count {
    justify-self: end;
    text-align: right;
  }

  .work-intro__body {
    align-self: end;
  }

  .work-lead {
    padding-bottom: var(--gap-inner);
  }

  .work-lead__media {
    border-radius: 2px;
  }

  .work-rows {
    padding-top: 0;
    padding-bottom: var(--gap-section);
  }

  /* Editorial rows, not a card archive. Two rows share the tall rhythm of the
     explicitly approved two-project launch; the title start column alternates
     between 03 and 04 to keep the sequence from reading as a table. */
  .work-row {
    border-top: 1px solid var(--hairline);
  }

  .work-row:last-child {
    border-bottom: 1px solid var(--hairline);
  }

  .work-row__link {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    align-items: center;
    min-height: clamp(140px, 15vw, 220px);
    padding-block: clamp(24px, 3vw, 40px);
  }

  .work-row__index {
    grid-column: 1 / 3;
  }

  .work-row__title {
    grid-column: 3 / 8;
    color: var(--fg-muted);
    transition: color var(--ui-medium) var(--ui-ease);
  }

  .work-row:nth-child(even) .work-row__title {
    grid-column: 4 / 9;
  }

  .work-row__type {
    grid-column: 9 / 10;
  }

  .work-row__platform {
    grid-column: 10 / 12;
  }

  .work-row__arrow {
    grid-column: 12;
    width: 18px;
    justify-self: end;
    color: var(--fg-muted);
    transition:
      transform var(--ui-medium) var(--ui-ease),
      color var(--ui-medium) var(--ui-ease);
  }

  /* The active row's title reaches full contrast; the others stay on the
     contrast-safe muted token rather than the source's 30% / 35% opacity. */
  .work-row__link:hover .work-row__title,
  .work-row__link:focus-visible .work-row__title {
    color: var(--fg);
  }

  .work-row__link:hover .work-row__arrow,
  .work-row__link:focus-visible .work-row__arrow {
    transform: translateX(6px);
    color: var(--fg);
  }

  .work-row__detail {
    padding-bottom: clamp(24px, 3vw, 40px);
  }

  .work-row__summary {
    max-width: 48ch;
    margin-left: calc((100% + var(--gutter)) / 12 * 2);
  }

  .work-row__media {
    display: none;
  }

  /* Touch and tablet: the pointer preview never loads, so the project media
     lives inside the row instead. */
  @media (max-width: 999px), (hover: none), (pointer: coarse) {
    .work-row__media {
      display: block;
      margin-top: 28px;
      border-radius: 2px;
    }

    .work-row__title {
      color: var(--fg);
    }
  }

  @media (max-width: 999px) {
    .work-row__link {
      grid-template-columns: repeat(8, minmax(0, 1fr));
      row-gap: 12px;
      min-height: 0;
    }

    .work-row__index {
      grid-column: 1 / 3;
    }

    .work-row__title,
    .work-row:nth-child(even) .work-row__title {
      grid-column: 1 / 8;
      grid-row: 2;
    }

    .work-row__type {
      grid-column: 1 / 4;
      grid-row: 3;
    }

    .work-row__platform {
      grid-column: 4 / 8;
      grid-row: 3;
    }

    .work-row__arrow {
      grid-column: 8;
      grid-row: 1;
    }

    .work-row__summary {
      margin-left: 0;
    }
  }
</style>
