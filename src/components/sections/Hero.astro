---
import { localeHref, t, type Locale } from '../../content/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = t(locale);
---

<section class="hero" aria-labelledby="hero-heading">
  <div class="frame hero__inner">
    <div class="grid hero__top">
      <p class="meta muted hero__eyebrow">{c.hero.eyebrow}</p>

      <h1 class="display-hero reveal-lines hero__headline" id="hero-heading" data-reveal="hero">
        <span class="line hero__line hero__line--1"><span>{c.hero.lines[0]}</span></span>
        <span class="line hero__line hero__line--2"><span>{c.hero.lines[1]}</span></span>
      </h1>
    </div>

    <hr class="rule hero__rule" data-reveal data-reveal-delay="380" />

    <div class="grid hero__bottom">
      <p class="body muted hero__body" data-reveal data-reveal-delay="440">{c.hero.body}</p>

      <div class="hero__actions" data-reveal data-reveal-delay="520">
        <a class="cta" href={localeHref(locale, '/work/')}>
          <span class="cta__labels">
            <span>{c.hero.primary}</span>
            <span aria-hidden="true">{c.hero.primary}</span>
          </span>
          <span class="cta__arrow" aria-hidden="true">→</span>
        </a>
        <a class="link hero__secondary" href="#approach">{c.hero.secondary}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: 100dvh;
    display: flex;
  }

  .hero__inner {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    width: 100%;
    padding-top: calc(clamp(76px, 6vw, 88px) + clamp(80px, 9vw, 150px));
    padding-bottom: clamp(48px, 7vw, 108px);
  }

  .hero__top {
    row-gap: clamp(28px, 4vw, 56px);
  }

  .hero__eyebrow {
    grid-column: 1 / span 4;
  }

  .hero__headline {
    grid-column: 1 / -1;
    /* never a ch-based width: a ch is measured on body type and would clip
       long Korean words inside the reveal mask */
    max-width: min(94rem, 100%);
  }

  /* the one-column offset on line 2 is the intended tension */
  .hero__line--2 {
    margin-left: calc((100% - 11 * var(--gutter)) / 12 + var(--gutter));
  }

  .hero__rule {
    margin-top: clamp(56px, 8vw, 120px);
  }

  .hero__bottom {
    margin-top: clamp(28px, 3.4vw, 48px);
    row-gap: 32px;
    align-items: start;
  }

  .hero__body {
    grid-column: 1 / span 5;
    max-width: 46ch;
  }

  .hero__actions {
    grid-column: 8 / span 5;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 28px;
  }

  .hero__secondary {
    font-size: 15px;
  }

  @media (max-width: 999px) {
    .hero__line--2 {
      margin-left: 0;
    }
    .hero__body {
      grid-column: 1 / span 7;
    }
    .hero__actions {
      grid-column: 1 / span 7;
    }
  }

  @media (max-width: 767px) {
    .hero__inner {
      justify-content: center;
      gap: 0;
    }
    .hero__actions .cta {
      width: 100%;
      justify-content: space-between;
    }
  }
</style>
