---
import { localeHref, projects, t, type Locale } from '../../content/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = t(locale);
---

<section class="work section" id="work" aria-labelledby="work-heading">
  <div class="frame">
    <div class="grid work__head">
      <p class="meta muted work__eyebrow" data-reveal>{c.work.eyebrow}</p>
      <h2 class="heading-2 work__title" id="work-heading" data-reveal>{c.work.heading}</h2>
      <p class="body muted work__intro" data-reveal data-reveal-delay="120">{c.work.intro}</p>
    </div>

    <div class="work__list">
      {
        projects.map((project, i) => {
          const copy = project[locale];
          return (
            <article class:list={['work__item', 'grid', i % 2 === 1 && 'work__item--flip']}>
              <div class="work__media media">
                <img
                  src={project.media.src}
                  width={project.media.width}
                  height={project.media.height}
                  alt={copy.mediaAlt}
                  loading={i === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                  sizes="(max-width: 767px) 100vw, 66vw"
                />
              </div>

              <div class="work__text" data-reveal>
                <p class="meta muted work__index">
                  {project.index} / {copy.category}
                </p>
                <h3 class="heading-3 work__name">
                  <a href={localeHref(locale, project.href)}>{copy.title}</a>
                </h3>
                <p class="body muted work__desc">{copy.summary}</p>
                <span class="link work__link" aria-hidden="true">
                  {c.work.view}
                  <span>→</span>
                </span>
              </div>
            </article>
          );
        })
      }
    </div>

    <p class="work__all" data-reveal>
      <a class="link" href={localeHref(locale, '/work/')}>{c.work.all} <span aria-hidden="true">→</span></a>
    </p>
  </div>
</section>

<style>
  .work__head {
    row-gap: 24px;
    align-items: start;
  }

  .work__eyebrow {
    grid-column: 1 / -1;
    margin-bottom: clamp(24px, 3vw, 48px);
  }

  .work__title {
    grid-column: 1 / span 7;
    max-width: min(38rem, 100%);
  }

  .work__intro {
    grid-column: 9 / span 4;
    max-width: 44ch;
  }

  .work__list {
    margin-top: clamp(64px, 9vw, 140px);
    display: flex;
    flex-direction: column;
    gap: var(--gap-project);
  }

  .work__item {
    row-gap: 32px;
    align-items: end;
  }

  .work__media {
    grid-column: 1 / span 8;
    border-radius: 14px;
  }

  .work__text {
    grid-column: 9 / span 4;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .work__item--flip .work__media {
    grid-column: 5 / span 8;
    grid-row: 1;
  }

  .work__item--flip .work__text {
    grid-column: 1 / span 4;
    grid-row: 1;
  }

  .work__name a::after {
    /* the whole media block is decorative, so the title carries the hit area */
    content: '';
    position: absolute;
    inset: 0;
  }

  .work__item {
    position: relative;
  }

  .work__desc {
    max-width: 42ch;
  }

  .work__link {
    font-size: 15px;
    align-self: flex-start;
  }

  .work__all {
    margin-top: clamp(64px, 8vw, 120px);
    padding-top: 28px;
    border-top: 1px solid var(--line);
  }

  @media (min-width: 768px) and (max-width: 999px) {
    .work__title {
      grid-column: 1 / span 12;
    }
    .work__intro {
      grid-column: 1 / span 8;
    }
    .work__media,
    .work__item--flip .work__media {
      grid-column: 1 / span 12;
      grid-row: auto;
    }
    .work__text,
    .work__item--flip .work__text {
      grid-column: 1 / span 9;
      grid-row: auto;
    }
  }

  @media (max-width: 767px) {
    .work__item {
      row-gap: 24px;
    }
    .work__media {
      order: -1;
    }
  }
</style>
