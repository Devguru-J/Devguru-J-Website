---
import { t, type Locale } from '../../content/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = t(locale);
---

<section class="approach section" id="approach" aria-labelledby="approach-heading">
  <div class="frame">
    <div class="grid approach__head">
      <p class="meta muted approach__eyebrow" data-reveal>{c.approach.eyebrow}</p>
      <h2 class="heading-2 approach__title" id="approach-heading" data-reveal>{c.approach.heading}</h2>
    </div>

    <ol class="approach__list">
      {
        c.approach.steps.map((step) => (
          <li class="approach__row grid" data-reveal>
            <p class="meta muted approach__index">{step.index}</p>
            <h3 class="approach__name">{step.title}</h3>
            <p class="body muted approach__body">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .approach__head {
    row-gap: 24px;
  }

  .approach__eyebrow {
    grid-column: 1 / -1;
    margin-bottom: clamp(24px, 3vw, 48px);
  }

  .approach__title {
    grid-column: 1 / span 7;
    max-width: min(40rem, 100%);
  }

  .approach__list {
    margin-top: clamp(56px, 8vw, 110px);
  }

  .approach__row {
    align-items: baseline;
    row-gap: 12px;
    padding-block: clamp(28px, 3.6vw, 52px);
    border-top: 1px solid var(--line);
  }

  .approach__row:last-child {
    border-bottom: 1px solid var(--line);
  }

  .approach__index {
    grid-column: 1 / span 2;
  }

  .approach__name {
    grid-column: 3 / span 4;
    font-size: clamp(22px, 2vw, 30px);
    letter-spacing: -0.025em;
    line-height: 1.2;
  }

  .approach__body {
    grid-column: 8 / span 5;
    max-width: 46ch;
  }

  @media (min-width: 768px) and (max-width: 999px) {
    .approach__index {
      grid-column: 1 / span 2;
    }
    .approach__name {
      grid-column: 3 / span 10;
    }
    .approach__body {
      grid-column: 3 / span 10;
    }
  }
</style>
