---
import { t, type Locale } from '../../content/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = t(locale);
---

<section class="studio section" id="studio" aria-labelledby="studio-heading">
  <div class="frame">
    <figure class="studio__figure" data-reveal>
      <div class="media studio__media">
        <picture>
          <source media="(max-width: 767px)" srcset="/assets/media/studio-portrait.jpg" />
          <img
            src="/assets/media/studio-wide.jpg"
            width="1760"
            height="770"
            alt={c.studio.alt}
            loading="lazy"
            decoding="async"
            sizes="100vw"
          />
        </picture>
      </div>
      <figcaption class="meta-sm muted studio__caption">{c.studio.caption}</figcaption>
    </figure>

    <div class="grid studio__text">
      <div class="studio__headwrap">
        <p class="meta muted studio__eyebrow" data-reveal>{c.studio.eyebrow}</p>
        <h2 class="heading-2 studio__title" id="studio-heading" data-reveal>{c.studio.heading}</h2>
      </div>

      <div class="studio__body" data-reveal data-reveal-delay="120">
        {c.studio.body.map((p) => <p class="body muted">{p}</p>)}
      </div>
    </div>
  </div>
</section>

<style>
  .studio__media {
    aspect-ratio: 16 / 7;
    border-radius: 14px;
  }

  .studio__caption {
    margin-top: 14px;
  }

  .studio__text {
    margin-top: clamp(96px, 11vw, 160px);
    row-gap: 32px;
    align-items: start;
  }

  .studio__headwrap {
    grid-column: 1 / span 7;
    display: flex;
    flex-direction: column;
    gap: clamp(20px, 2.6vw, 40px);
  }

  .studio__title {
    max-width: min(36rem, 100%);
  }

  .studio__body {
    grid-column: 9 / span 4;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  @media (max-width: 767px) {
    .studio__media {
      aspect-ratio: 4 / 5;
    }
  }

  @media (min-width: 768px) and (max-width: 999px) {
    .studio__headwrap {
      grid-column: 1 / span 12;
    }
    .studio__body {
      grid-column: 1 / span 8;
    }
  }
</style>
