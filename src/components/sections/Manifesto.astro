---
import { t, type Locale } from '../../content/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = t(locale);
---

<section class="curtain ink" aria-labelledby="manifesto-heading">
  <div class="frame curtain__inner">
    <p class="meta muted curtain__eyebrow">{c.manifesto.eyebrow}</p>

    <h2 class="display-section reveal-lines curtain__lines" id="manifesto-heading">
      <span class="line"><span>{c.manifesto.lines[0]}</span></span>
      <span class="line curtain__offset"><span>{c.manifesto.lines[1]}</span></span>
    </h2>

    <p class="meta muted curtain__mark">{c.manifesto.mark}</p>
  </div>
</section>

<style>
  .curtain {
    min-height: 74dvh;
    display: grid;
    align-items: center;
    padding-block: clamp(88px, 12vw, 160px);
  }

  .curtain__inner {
    display: grid;
    row-gap: clamp(40px, 6vw, 80px);
    width: 100%;
  }

  .curtain__lines {
    /* the blueprint caps this at 10 columns; the two sentences need a little
       more room to stay on two lines, which the blueprint values more */
    max-width: min(84rem, 100%);
  }

  .curtain__offset {
    margin-left: clamp(0px, 6vw, 96px);
  }

  .curtain__mark {
    justify-self: end;
  }

  @media (max-width: 767px) {
    .curtain__lines {
      max-width: 100%;
    }
    .curtain__offset {
      margin-left: 0;
    }
    .curtain__mark {
      justify-self: start;
    }
  }
</style>
