---
import { t, type Locale } from '../../content/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = t(locale);
---

<section class="cap section" id="capabilities" aria-labelledby="cap-heading" data-capabilities>
  <div class="frame">
    <div class="grid cap__head">
      <p class="meta muted cap__eyebrow" data-reveal>{c.capabilities.eyebrow}</p>
      <h2 class="heading-2 cap__title" id="cap-heading" data-reveal>{c.capabilities.heading}</h2>
    </div>

    <div class="grid cap__body">
      {/* desktop only — hidden and lazy on small screens so it is never fetched twice */}
      <div class="cap__stage" aria-hidden="true">
        {
          c.capabilities.rows.map((row, i) => (
            <figure class:list={['cap__figure', 'media', i === 0 && 'is-active']} data-capability-media>
              <img src={row.media} width="1000" height="1250" alt="" loading="lazy" decoding="async" sizes="34vw" />
            </figure>
          ))
        }
      </div>

      <ol class="cap__rows">
        {
          c.capabilities.rows.map((row, i) => (
            <li class:list={['cap__row', i === 0 && 'is-active']} data-capability-row>
              <figure class="cap__inline media">
                <img
                  src={row.media}
                  width="1000"
                  height="1250"
                  alt={row.alt}
                  loading="lazy"
                  decoding="async"
                  sizes="100vw"
                />
              </figure>
              <div class="cap__rowtext">
                <p class="meta muted">{row.index}</p>
                <h3 class="heading-3 cap__rowtitle">{row.title}</h3>
                <p class="body cap__rowbody">{row.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .cap__head {
    row-gap: 24px;
  }

  .cap__eyebrow {
    grid-column: 1 / -1;
    margin-bottom: clamp(24px, 3vw, 48px);
  }

  .cap__title {
    grid-column: 1 / span 8;
    max-width: min(44rem, 100%);
  }

  .cap__body {
    margin-top: clamp(56px, 8vw, 120px);
  }

  .cap__stage {
    display: none;
    grid-column: 1 / span 5;
    position: sticky;
    top: calc(clamp(76px, 6vw, 88px) + 20px);
    align-self: start;
    aspect-ratio: 4 / 5;
  }

  .cap__figure {
    position: absolute;
    inset: 0;
    opacity: 0;
    border-radius: 12px;
    overflow: hidden;
  }

  .cap__figure.is-active {
    opacity: 1;
  }

  .cap__rows {
    grid-column: 7 / span 6;
    display: flex;
    flex-direction: column;
  }

  .cap__row {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding-block: clamp(32px, 5vw, 56px);
    border-top: 1px solid var(--line);
  }

  .cap__row:last-child {
    border-bottom: 1px solid var(--line);
  }

  .cap__rowtext {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .cap__rowbody {
    max-width: 46ch;
  }

  .cap__inline {
    border-radius: 12px;
  }

  @media (min-width: 1000px) {
    .cap__stage {
      display: block;
    }
    .cap__inline {
      display: none;
    }
    .cap__row {
      min-height: 56dvh;
      justify-content: center;
      /* state is carried by contrast and weight only — no accent colour */
      opacity: 0.4;
      transition: opacity 0.6s var(--ease);
    }
    .cap__row.is-active {
      opacity: 1;
    }
    .cap__rowtitle {
      font-weight: 500;
      transition: font-variation-settings 0.6s var(--ease);
    }
  }

  @media (max-width: 999px) {
    .cap__rows {
      gap: 0;
    }
  }
</style>
