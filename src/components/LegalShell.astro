---
/**
 * Monkey Flash 법적 페이지의 껍데기.
 *
 * `privacy.astro` 와 `support.astro` 의 본문·시행일·자체 <style is:global> 블록은
 * App Store 심사에 걸려 있는 문서이므로 한 글자도 바꾸지 않는다. 그 블록들이
 * 참조하는 --color-ink / --color-ink-2 / --color-amber / --color-container-low /
 * --font-mono 는 아래에서 현재 디자인 토큰으로 별칭 처리한다.
 *
 * 두 페이지는 하나의 URL에 EN/KO가 함께 있는 단일 라우트다. 토글은 보이는
 * 섹션과 html[lang] 만 바꾸고 주소는 바꾸지 않는다.
 *
 * 이 페이지들은 색 반전 대상이 아니다 — 읽는 문서이므로 흰 배경에 고정한다.
 * (data-color-change-* 속성을 붙이지 않는 이유)
 */
import Base from '../layouts/Base.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  /** 문서 상단 표기, 예: "MONKEY FLASH — PRIVACY POLICY". */
  overline: string;
  /** 푸터 저작권 줄에 붙는 앱 이름. */
  appName?: string;
  /** 푸터 링크. 앱마다 페이지 구성이 달라 목록으로 받는다. */
  links?: { href: string; label: string }[];
  /**
   * EN/KO 토글. 단일 언어 문서는 끈다 — 끄면 아래 스크립트가 버튼을 못 찾고
   * 아무것도 하지 않으므로 html[lang] 도 건드리지 않는다.
   */
  langToggle?: boolean;
}

const {
  title,
  description,
  overline,
  appName = 'Monkey Flash',
  links = [
    { href: '/MonkeyFlash/privacy/', label: 'Privacy' },
    { href: '/MonkeyFlash/support/', label: 'Support' },
  ],
  langToggle = true,
} = Astro.props;
const year = new Date().getFullYear();
---

<Base title={title} description={description} hideFooter={true}>
  <article class="legal-shell">
    <div class="container legal-shell__inner">
      <div class="legal-head">
        <p class="legal-overline">{overline}</p>
        {
          langToggle && (
            <div class="legal-lang" role="group" aria-label="Language">
              <button type="button" data-lang="en">EN</button>
              <span class="legal-lang__sep" aria-hidden="true">/</span>
              <button type="button" data-lang="ko">KO</button>
            </div>
          )
        }
      </div>

      <slot />

      <footer class="legal-foot">
        <hr class="rule" />
        <div class="legal-foot__grid">
          <p>© {year} {site.nameKo} / {appName}</p>
          <p class="legal-foot__links">
            {links.map((link) => <a href={link.href}>{link.label}</a>)}
            <a href={`mailto:${site.email}`}>Email</a>
          </p>
        </div>
      </footer>
    </div>
  </article>
</Base>

<style is:global>
  /* 손대지 않은 본문 스타일 블록이 참조하는 이름들. 검정 글자 위에서만
     쓰이므로 전부 currentColor 기반으로 맞춘다. */
  .legal-shell {
    --color-ink: currentColor;
    --color-ink-2: color-mix(in srgb, currentColor 72%, transparent);
    --color-amber: currentColor;
    --color-container-low: color-mix(in srgb, currentColor 4%, transparent);
    --font-mono: inherit;
    --legal-hairline: color-mix(in srgb, currentColor 14%, transparent);
  }

  /* =====================================================================
     본문을 사이트의 편집 디자인에 맞추는 오버라이드.

     각 페이지의 본문과 자체 <style is:global> 블록(심사에 걸린 문서)은
     그대로 두고, `.legal-shell .legal` 의 더 높은 특이성으로만 덮어쓴다.
     내용·마크업·URL 은 바뀌지 않는다.
     ===================================================================== */

  /* 제목 — 작업 상세의 헤드와 같은 눈금·자간 */
  .legal-shell .legal h1 {
    font-size: var(--memory-fs-h2);
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 1.12;
    margin-bottom: 0;
  }

  /* 리드 줄(시행일·요약) — .lead 와 같은 처리 */
  .legal-shell .legal .eff {
    font-size: var(--memory-fs-lead);
    line-height: 1.7;
    letter-spacing: -0.025em;
    margin-top: 1.4rem;
    margin-bottom: clamp(3.5rem, 6vw, 5.5rem);
    max-width: 48ch;
  }

  /* 장 제목 — 헤어라인 위에 얹히는 chapter 리듬 */
  .legal-shell .legal h2 {
    font-size: var(--memory-fs-h3);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.25;
    margin: clamp(3.5rem, 6vw, 5.5rem) 0 1.1em;
    padding-top: clamp(2rem, 3.2vw, 2.75rem);
    border-top: 1px solid var(--legal-hairline);
  }

  .legal-shell .legal h3 {
    font-size: var(--memory-fs-h4);
    font-weight: 600;
    letter-spacing: -0.02em;
    margin: 2.4em 0 0.65em;
  }

  .legal-shell .legal p,
  .legal-shell .legal ol,
  .legal-shell .legal ul {
    font-size: clamp(1rem, 0.95rem + 0.25vw, 1.125rem);
    line-height: 1.85;
    letter-spacing: -0.02em;
  }

  .legal-shell .legal li {
    margin-bottom: 0.5em;
  }

  .legal-shell .legal li::marker {
    color: color-mix(in srgb, currentColor 40%, transparent);
    font-variant-numeric: tabular-nums;
  }

  /* 링크 — 앰버 강조 대신 사이트의 currentColor 밑줄 */
  .legal-shell .legal a {
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    text-decoration-color: color-mix(in srgb, currentColor 30%, transparent);
    transition: text-decoration-color 0.4s var(--nectar-cubic-bezier-out);
  }

  .legal-shell .legal a:hover,
  .legal-shell .legal a:focus-visible {
    text-decoration-color: currentColor;
  }

  /* 연락 카드 — 그림자 박스 대신 헤어라인 컨테이너 */
  .legal-shell .legal .contact-card {
    margin-top: clamp(2.5rem, 4vw, 3.5rem);
    padding: clamp(1.75rem, 3vw, 2.5rem) clamp(1.75rem, 3.2vw, 2.75rem);
    background: var(--color-container-low);
    box-shadow: none;
    border: 1px solid var(--legal-hairline);
    line-height: 1.85;
    font-size: clamp(1rem, 0.95rem + 0.25vw, 1.125rem);
    letter-spacing: -0.02em;
  }

  /* 표 — 본문과 같은 눈금, 헤어라인 행 구분 */
  .legal-shell .legal table {
    font-size: clamp(0.9375rem, 0.9rem + 0.2vw, 1.0625rem);
    line-height: 1.7;
    letter-spacing: -0.015em;
  }

  .legal-shell .legal th,
  .legal-shell .legal td {
    padding: 0.8em 1em 0.8em 0;
    border-color: var(--legal-hairline);
  }

  .legal-shell .legal th {
    font-weight: 500;
  }

  /* 좁은 화면에서 표가 세로로 쌓일 때(LegalBodyStyles 의 규칙)의 여백을
     위 패딩 오버라이드가 이기지 않도록 같은 조건으로 되돌린다. */
  @media (max-width: 560px) {
    .legal-shell .legal th,
    .legal-shell .legal td {
      border: 0;
      padding: 0;
    }

    .legal-shell .legal th {
      margin-bottom: 4px;
    }
  }
</style>

<style>
  .legal-shell {
    padding-block: clamp(150px, 18vh, 230px) clamp(48px, 6vw, 80px);
  }

  .legal-shell__inner {
    max-width: min(100%, 880px);
    margin-inline: auto;
  }

  .legal-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 2rem;
    padding-bottom: 1.1rem;
    margin-bottom: clamp(48px, 7vw, 88px);
    border-bottom: 1px solid;
    border-color: color-mix(in srgb, currentColor 14%, transparent);
  }

  /* 사이트의 .eyebrow 와 같은 처리 */
  .legal-overline {
    font-size: var(--memory-fs-meta);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    line-height: 1;
    opacity: 0.55;
  }

  .legal-lang {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: var(--memory-fs-meta);
    letter-spacing: 0.1em;
  }

  .legal-lang button {
    background: none;
    border: 0;
    padding: 4px 2px;
    cursor: pointer;
    opacity: 0.4;
    transition: opacity 0.4s var(--nectar-cubic-bezier-out);
  }

  .legal-lang button:hover,
  .legal-lang button:focus-visible,
  .legal-lang button.active {
    opacity: 1;
  }

  .legal-lang__sep {
    opacity: 0.25;
  }

  .legal-foot {
    margin-top: clamp(72px, 10vw, 120px);
  }

  .legal-foot__grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-top: 1.75rem;
    font-size: var(--memory-fs-meta);
    opacity: 0.5;
  }

  .legal-foot__links {
    display: flex;
    gap: 1.5rem;
  }

  .legal-foot__links a {
    border-bottom: 1px solid transparent;
    transition: border-color 0.4s var(--nectar-cubic-bezier-out);
  }

  .legal-foot__links a:hover,
  .legal-foot__links a:focus-visible {
    border-bottom-color: currentColor;
  }

  @media (max-width: 640px) {
    .legal-head {
      flex-direction: column;
      gap: 1rem;
    }

    .legal-foot__grid {
      flex-direction: column;
    }
  }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-lang]');
  const sections = document.querySelectorAll<HTMLElement>('[data-section]');
  const setLang = (lang: string) => {
    buttons.forEach((b) => b.classList.toggle('active', b.dataset.lang === lang));
    sections.forEach((s) => (s.hidden = s.dataset.section !== lang));
    document.documentElement.lang = lang;
    localStorage.setItem('devguru-lang', lang);
  };
  // 토글을 끈 단일 언어 문서에서는 버튼도 섹션도 없다. 그대로 두면 setLang 이
  // html[lang] 을 en 으로 덮어써 한국어 문서가 영어라고 선언된다.
  if (buttons.length) {
    buttons.forEach((b) => b.addEventListener('click', () => setLang(b.dataset.lang!)));
    // 우선순위: 명시적 ?lang= (App Store 로케일별 URL에서 사용) > 저장된 선택 > 영문.
    // 문서 자체의 소스 순서(EN 먼저)와 같다.
    const param = new URLSearchParams(location.search).get('lang');
    const initial =
      param === 'ko' || param === 'en'
        ? param
        : (localStorage.getItem('devguru-lang') ?? 'en');
    setLang(initial);
  }
</script>
