---
/**
 * Shell for the Monkey Flash legal pages.
 *
 * Only this shell is restyled. `privacy.astro` and `support.astro` — their body
 * copy, their effective dates and their own <style is:global> blocks — stay
 * byte-for-byte untouched. Those blocks reference three custom properties
 * (--color-ink, --color-ink-2, --color-amber) and --font-mono, which are
 * aliased onto the new token system below so the documents keep rendering
 * without a single edit to their content.
 *
 * These are bilingual single routes: the URL never changes, the visible section
 * and html[lang] do (03 §8).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { CONTACT } from '../content/brand';

interface Props {
  title: string;
  description: string;
  path: string;
  /** Mono overline above the content, e.g. "MONKEY FLASH — PRIVACY POLICY". */
  overline: string;
}

const { title, description, path, overline } = Astro.props;
const year = new Date().getFullYear();
---

<BaseLayout
  locale="en"
  path={path}
  title={title}
  description={description}
  chrome={false}
  singleRoute
>
  <div class="legal-shell scene" data-surface="paper">
    <nav class="legal-nav">
      <div class="frame legal-nav__inner">
        <a class="legal-brand" href="/">Memory</a>
        <div class="legal-nav__end">
          <div class="legal-lang" role="group" aria-label="Language">
            <button type="button" class="meta" data-lang="en">EN</button>
            <span class="legal-lang__sep" aria-hidden="true">/</span>
            <button type="button" class="meta" data-lang="ko">KO</button>
          </div>
          <a class="meta legal-home" href="/">← Home</a>
        </div>
      </div>
    </nav>

    <div class="frame legal-main">
      <p class="meta meta--muted legal-overline">{overline}</p>
      <slot />
    </div>

    <footer class="legal-foot">
      <div class="frame legal-foot__inner">
        <span class="meta meta--muted">© {year} Memory / Monkey Flash</span>
        <div class="legal-foot__links">
          <a class="meta" href="/MonkeyFlash/privacy/">Privacy</a>
          <a class="meta" href="/MonkeyFlash/support/">Support</a>
          <a class="meta" href={`mailto:${CONTACT.email}`}>Email</a>
        </div>
      </div>
    </footer>
  </div>
</BaseLayout>

<style is:global>
  /* Compatibility aliases for the untouched legal page style blocks. */
  :root {
    --color-ink: var(--ink-950);
    --color-ink-2: var(--graphite-600);
    --color-amber: var(--ink-950);
  }

  .legal-shell {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
  }

  .legal-nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--paper-100) 92%, transparent);
    backdrop-filter: saturate(140%) blur(10px);
    border-bottom: 1px solid var(--hairline);
  }

  .legal-nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    height: var(--header-h);
  }

  .legal-brand {
    font-family: var(--font-serif);
    font-size: 25px;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .legal-nav__end {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .legal-lang {
    display: flex;
    align-items: center;
    gap: 7px;
  }

  .legal-lang button {
    min-height: 44px;
    opacity: 0.5;
    transition: opacity var(--ui-fast) var(--ui-ease);
  }

  .legal-lang button:hover,
  .legal-lang button:focus-visible {
    opacity: 1;
  }

  .legal-lang button.active {
    opacity: 1;
  }

  .legal-lang__sep {
    opacity: 0.3;
    font-family: var(--font-mono);
    font-size: var(--t-meta);
  }

  .legal-home {
    display: none;
    align-items: center;
    min-height: 44px;
    border-bottom: 1px solid transparent;
    transition: border-color var(--ui-fast) var(--ui-ease);
  }

  .legal-home:hover,
  .legal-home:focus-visible {
    border-bottom-color: currentColor;
  }

  .legal-main {
    flex: 1;
    /* Reading width, not the full content frame. */
    max-width: 76ch;
    margin-inline: auto;
    padding-top: clamp(56px, 8vw, 104px);
    padding-bottom: clamp(96px, 12vw, 160px);
  }

  .legal-overline {
    margin-bottom: clamp(36px, 5vw, 64px);
    padding-bottom: 16px;
    border-bottom: 1px solid var(--hairline);
  }

  .legal-foot {
    border-top: 1px solid var(--hairline);
  }

  .legal-foot__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding-block: 32px;
  }

  .legal-foot__links {
    display: flex;
    gap: 28px;
  }

  .legal-foot__links a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    border-bottom: 1px solid transparent;
    transition: border-color var(--ui-fast) var(--ui-ease);
  }

  .legal-foot__links a:hover,
  .legal-foot__links a:focus-visible {
    border-bottom-color: currentColor;
  }

  @media (min-width: 640px) {
    .legal-home {
      display: inline-flex;
    }
  }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-lang]');
  const sections = document.querySelectorAll<HTMLElement>('[data-section]');
  const setLang = (lang: string) => {
    buttons.forEach((b) => b.classList.toggle('active', b.dataset.lang === lang));
    sections.forEach((s) => (s.hidden = s.dataset.section !== lang));
    document.documentElement.lang = lang;
    localStorage.setItem('devguru-lang', lang);
    document.cookie = `lang=${lang}; path=/; max-age=31536000; samesite=lax`;
  };
  buttons.forEach((b) => b.addEventListener('click', () => setLang(b.dataset.lang!)));
  // Priority: explicit ?lang= param (used for per-locale App Store URLs) >
  // saved choice > English, matching the documents' own source order.
  const param = new URLSearchParams(location.search).get('lang');
  const initial =
    param === 'ko' || param === 'en'
      ? param
      : (localStorage.getItem('devguru-lang') ?? 'en');
  setLang(initial);
</script>
