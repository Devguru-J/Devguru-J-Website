---
/**
 * Salient `nectar_post_grid[data-style="vertical_list"]`
 * with `vertical_list_hover_effect = featured_image_follow`.
 *
 * Ported 1:1 from:
 *   includes/class-nectar-element-styles.php  (vertical_list §, featured_image_follow §)
 *   js/src/init.js                            (NectarIconMouseFollow, iconType 'post-grid-images')
 *
 * Layout is built for a small, curated set — 3~5 items is the sweet spot.
 * Items without a `cover` simply have no follow-image; the row still works.
 */
import type { Work } from '../data/works';

interface Props {
  works: Work[];
  /**
   * 아직 채우지 않은 자리. 번호와 '준비 중'만 렌더합니다.
   * 링크도, 상세 페이지도, 사이트맵 항목도 만들지 않습니다 —
   * 없는 제품을 지어내지 않으면서 늘어날 예정이라는 것만 보여주는 자리입니다.
   */
  pending?: Work[];
  class?: string;
}

const { works, pending = [], class: className = '', ...rest } = Astro.props;
---

<div
  class:list={['nectar-post-grid-wrap', className]}
  data-style="vertical_list"
  {...rest}
>
  <div
    class="nectar-post-grid vert_list_counter vert_list_hover_effect_featured_image_follow"
    data-animation="fade-in-from-bottom"
  >
    {
      works.map((work, i) => (
        <div class="nectar-post-grid-item col has-animation" data-animation="fade-in" data-delay={i * 90}>
          <a class="inner" href={`/work/${work.slug}/`} aria-label={`${work.title} — 자세히 보기`}>
            <div class="content">
              <div class="item-main">
                <div class="post-heading-wrap">
                  <h3 class="post-heading">{work.title}</h3>
                  <p class="meta-excerpt">{work.summary}</p>
                </div>

                <div class="nectar-post-grid-item__meta-wrap">
                  <span class="meta-category">{work.category}</span>
                  <span class="meta-date">
                    {work.platform} · {work.year}
                  </span>
                </div>

                <span class="nectar-link-underline"><span>자세히 보기</span></span>
              </div>
            </div>

            {/* Cursor-following media. position:fixed — moved by motion.js each rAF. */}
            <div class="nectar-post-grid-item-bg">
              <div class="nectar-post-grid-item-bg__media">
                {work.cover ? (
                  <img src={work.cover} alt="" loading="lazy" decoding="async" width="1200" height="900" />
                ) : (
                  <span class="nectar-post-grid-item-bg__plate">{work.titleEn}</span>
                )}
              </div>
            </div>
          </a>
        </div>
      ))
    }

    {
      pending.map((slot, i) => (
        <div
          class="nectar-post-grid-item is-pending col has-animation"
          data-animation="fade-in"
          data-delay={(works.length + i) * 90}
        >
          <div class="inner">
            <div class="content">
              <div class="item-main">
                <div class="post-heading-wrap">
                  <h3 class="post-heading">준비 중</h3>
                </div>
              </div>
            </div>
          </div>
        </div>
      ))
    }
  </div>
</div>

<style is:global>
  /* ─────────────────────────────────────────────────────────────────
     Salient vertical_list — core
     class-nectar-element-styles.php §'vertical_list' === $post_grid_style
     ───────────────────────────────────────────────────────────────── */

  .nectar-post-grid-wrap[data-style='vertical_list'] {
    --hover-easing: cubic-bezier(0.1, 0.75, 0.5, 1);
    --vert-list-border: color-mix(in srgb, currentColor 15%, transparent);
  }

  .nectar-post-grid-wrap[data-style='vertical_list'] .nectar-post-grid-item {
    position: relative;
    counter-increment: step-counter;
  }

  .nectar-post-grid-wrap[data-style='vertical_list'] .inner {
    display: block;
    overflow: visible;
    border-radius: 0;
    transform: none;
  }

  .nectar-post-grid-wrap[data-style='vertical_list'] .content {
    padding: clamp(28px, 3.2vw, 45px) 0;
  }

  /* Hairlines — top rule on the first row, bottom rule on every row.
     Animate scaleX 0 → 1 over 1s ease as each row enters. */
  .nectar-post-grid-wrap[data-style='vertical_list'] .nectar-post-grid > div:first-child:before,
  .nectar-post-grid-wrap[data-style='vertical_list'] .nectar-post-grid > div:after {
    position: absolute;
    left: 0;
    width: 100%;
    height: 1px;
    content: '';
    display: block;
    transition: transform 1s ease;
    transform-origin: left;
    background-color: var(--vert-list-border);
  }

  .nectar-post-grid-wrap[data-style='vertical_list'] .nectar-post-grid > div:first-child:before {
    top: 0;
  }

  .nectar-post-grid-wrap[data-style='vertical_list'] .nectar-post-grid > div:after {
    bottom: 0;
  }

  .nectar-post-grid-wrap[data-style='vertical_list']
    .nectar-post-grid[data-animation='fade-in-from-bottom']
    > div:before,
  .nectar-post-grid-wrap[data-style='vertical_list']
    .nectar-post-grid[data-animation='fade-in-from-bottom']
    > div:after {
    transform: scaleX(0);
  }

  .nectar-post-grid-wrap[data-style='vertical_list']
    .nectar-post-grid[data-animation='fade-in-from-bottom']
    > .animated-in:before,
  .nectar-post-grid-wrap[data-style='vertical_list']
    .nectar-post-grid[data-animation='fade-in-from-bottom']
    > .animated-in:after {
    transform: scaleX(1);
  }

  /* Row body */
  .nectar-post-grid-wrap[data-style='vertical_list'] .content .item-main {
    display: flex;
    flex-direction: column;
    position: relative;
    z-index: 2;
  }

  .nectar-post-grid-wrap[data-style='vertical_list'] .item-main .post-heading-wrap {
    flex: 1;
  }

  .nectar-post-grid-wrap[data-style='vertical_list'] .post-heading {
    font-size: clamp(1.75rem, 3.6vw, 3.25rem);
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 1.15;
  }

  .nectar-post-grid-wrap[data-style='vertical_list'] .meta-excerpt {
    margin-top: 0.85rem;
    font-size: 1rem;
    line-height: 1.7;
    opacity: 0.5;
    max-width: 38ch;
  }

  .nectar-post-grid-wrap[data-style='vertical_list'] .nectar-post-grid-item__meta-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.4em;
    margin-top: 0;
    font-size: var(--fs-meta);
    letter-spacing: 0.02em;
  }

  .nectar-post-grid-wrap[data-style='vertical_list'] .meta-category {
    opacity: 0.4;
  }

  .nectar-post-grid-wrap[data-style='vertical_list'] .meta-date {
    font-variant-numeric: tabular-nums;
    opacity: 0.75;
  }

  .nectar-post-grid-wrap[data-style='vertical_list'] .nectar-link-underline {
    font-size: 0.9375rem;
    font-weight: 500;
    white-space: nowrap;
  }

  .nectar-post-grid-wrap[data-style='vertical_list'] .nectar-link-underline span {
    background-repeat: no-repeat;
    background-image: linear-gradient(to right, currentColor 0%, currentColor 100%);
    background-size: 0% 1px;
    background-position: left bottom;
    transition: background-size 0.55s var(--ease-underline);
    padding: 2px 0;
  }

  .nectar-post-grid-wrap[data-style='vertical_list']
    .nectar-post-grid-item:hover
    .nectar-link-underline
    span {
    background-size: 100% 1px;
  }

  /* Counter — 40px circle, Salient exact */
  .nectar-post-grid.vert_list_counter .item-main:before {
    content: counter(step-counter, decimal-leading-zero);
    margin-right: 25px;
    border: 1px solid var(--vert-list-border);
    display: block;
    position: relative;
    z-index: 10;
    height: 40px;
    width: 40px;
    line-height: 38px;
    font-size: 13px;
    font-variant-numeric: tabular-nums;
    pointer-events: none;
    text-align: center;
    border-radius: 50%;
    flex: none;
    transition: color 0.45s cubic-bezier(0.15, 0.75, 0.5, 1) 0s,
      border-color 0.45s cubic-bezier(0.15, 0.75, 0.5, 1) 0s,
      transform 0.6s var(--hover-easing);
  }

  .nectar-post-grid.vert_list_counter .nectar-post-grid-item:hover .item-main:before {
    border-color: currentColor;
  }

  @media only screen and (min-width: 1000px) {
    .nectar-post-grid-wrap[data-style='vertical_list'] .content .item-main {
      flex-direction: row;
      align-items: center;
    }

    .nectar-post-grid-wrap[data-style='vertical_list']
      .item-main
      .nectar-post-grid-item__meta-wrap {
      padding-right: 8%;
      min-width: 22%;
    }

    .nectar-post-grid-wrap[data-style='vertical_list'] .item-main .nectar-link-underline {
      margin-left: auto;
      padding-left: 8%;
    }
  }

  @media only screen and (max-width: 999px) {
    .nectar-post-grid-wrap[data-style='vertical_list'] .nectar-post-grid-item .item-main > * {
      margin: 5px 0;
    }

    .nectar-post-grid.vert_list_counter .item-main:before {
      position: absolute;
      left: 0;
      top: 0;
      margin-right: 0;
    }

    .nectar-post-grid.vert_list_counter .item-main {
      padding-left: 65px;
    }

    .nectar-post-grid-wrap[data-style='vertical_list']
      .nectar-post-grid.vert_list_counter
      .item-main
      > *:first-child {
      margin-top: 0;
    }

    .nectar-post-grid-wrap[data-style='vertical_list'] .nectar-link-underline {
      display: inline-block;
      margin-top: 1.25rem;
    }
  }

  /* ─────────────────────────────────────────────────────────────────
     featured_image_follow — cursor-tracked media
     ───────────────────────────────────────────────────────────────── */

  .vert_list_hover_effect_featured_image_follow .nectar-post-grid-item-bg {
    position: static;
  }

  .vert_list_hover_effect_featured_image_follow .nectar-post-grid-item-bg__media {
    position: fixed;
    left: -10vw;
    top: calc((10vw / 1.3) * -1);
    z-index: 10;
    opacity: 0;
    overflow: hidden;
    pointer-events: none;
    width: 20vw;
    height: auto;
    aspect-ratio: 4 / 3;
    transition: opacity 0.25s ease;
    visibility: hidden;
  }

  .vert_list_hover_effect_featured_image_follow .nectar-post-grid-item-bg__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .vert_list_hover_effect_featured_image_follow .nectar-post-grid-item-bg__plate {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    background-color: var(--nectar-page-text-color, #000);
    color: var(--nectar-page-background-color, #fff);
    font-size: clamp(1rem, 1.5vw, 1.5rem);
    font-weight: 300;
    letter-spacing: -0.04em;
    text-align: center;
    padding-inline: 1em;
  }

  /* Non-hovered rows fade out with a 0.15s lag so the swap crossfades. */
  .nectar-post-grid.vert_list_hover_effect_featured_image_follow:not(:hover)
    .nectar-post-grid-item
    .nectar-post-grid-item-bg__media {
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .nectar-post-grid.vert_list_hover_effect_featured_image_follow.mouse-over
    .nectar-post-grid-item
    .nectar-post-grid-item-bg__media {
    animation: nectar_vert_list_hover_effect_featured_image_follow_scale 0.6s
      var(--hover-easing) forwards;
    will-change: transform, clip-path, opacity;
  }

  @media only screen and (min-width: 1000px) {
    .vert_list_hover_effect_featured_image_follow
      .nectar-post-grid-item:hover
      .nectar-post-grid-item-bg__media {
      z-index: 1000;
      opacity: 1;
      transition: opacity 0s ease;
    }
  }

  @keyframes nectar_vert_list_hover_effect_featured_image_follow_scale {
    from {
      clip-path: inset(20% 20% 20% 20%);
    }
    to {
      clip-path: inset(0% 0% 0% 0%);
    }
  }

  /* Heading wipe-in on scroll — mask gradient swept across the text. */
  @keyframes nectar_reveal_fade_in {
    from {
      mask-position: 100% 100%;
    }
    to {
      mask-position: 0 100%;
    }
  }

  [data-animation='fade-in-from-bottom'].vert_list_hover_effect_featured_image_follow .post-heading {
    transition: all 0.85s cubic-bezier(0.4, 0, 0.3, 1);
    mask-image: linear-gradient(90deg, #fff 33.3%, rgba(255, 255, 255, 0.1) 66.6%);
    mask-position: 100% 100%;
    mask-size: 300% 100%;
    display: inline-block;
    width: auto;
  }

  .vert_list_hover_effect_featured_image_follow .nectar-post-grid-item.animated-in .post-heading {
    animation: nectar_reveal_fade_in 0.85s cubic-bezier(0.4, 0, 0.3, 1) forwards;
  }

  /* ── 아직 채우지 않은 자리 ──────────────────────────────────────────
     번호는 세로 리스트의 카운터를 그대로 이어받는다. 링크가 없으므로
     밑줄·메타·커서 추종 이미지도 없다. 제목만 작게, 흐리게 둔다.       */

  .nectar-post-grid-wrap[data-style='vertical_list'] .is-pending .post-heading {
    font-size: clamp(1rem, 1.6vw, 1.25rem);
    font-weight: 400;
    letter-spacing: 0.02em;
    opacity: 0.3;
  }

  .nectar-post-grid-wrap[data-style='vertical_list'] .is-pending .content {
    padding-block: clamp(20px, 2.2vw, 30px);
  }

  .nectar-post-grid-wrap[data-style='vertical_list'] .is-pending .item-main:before {
    opacity: 0.3;
  }

  /* Touch / coarse pointer — no cursor to follow. */
  @media (hover: none), (max-width: 999px) {
    .vert_list_hover_effect_featured_image_follow .nectar-post-grid-item-bg__media {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .vert_list_hover_effect_featured_image_follow .nectar-post-grid-item-bg__media {
      display: none;
    }

    .nectar-post-grid-wrap[data-style='vertical_list'] .nectar-post-grid > div:before,
    .nectar-post-grid-wrap[data-style='vertical_list'] .nectar-post-grid > div:after {
      transform: scaleX(1) !important;
    }

    [data-animation='fade-in-from-bottom'].vert_list_hover_effect_featured_image_follow .post-heading {
      mask-image: none;
      animation: none;
    }
  }
</style>
