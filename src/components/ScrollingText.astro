---
/**
 * Salient `nectar-scrolling-text`.
 *
 * Ported verbatim from css/src/elements/element-scrolling-text.css:
 *   · resting transform translateX(-20%) translateZ(0)
 *   · keyframe -20% → -120%, `linear infinite`
 *   · speed presets — slower 45s · slowest 30s · (default) 15s · slow 14s ·
 *     medium 7s · fast 4s
 *   · data-spacing="true" adds padding-left: 0.45em per chunk
 *   · .prevent-animation kills the animation (used for reduced motion)
 *
 * Salient duplicates the text chunk so the strip never shows a gap; the
 * duplicate is aria-hidden here so screen readers read the line once.
 */
interface Props {
  /** Salient speed preset. */
  speed?: 'slowest' | 'slower' | 'slow' | 'medium' | 'fast';
  /** 몇 번 반복해 채울지. 화면 폭보다 길어야 끊기지 않습니다. */
  repeat?: number;
  class?: string;
}

const { speed = 'slower', repeat = 4, class: className, ...rest } = Astro.props;
const items = Array.from({ length: repeat });
---

<div
  class:list={['nectar-scrolling-text', className]}
  data-s-speed={speed}
  data-spacing="true"
  {...rest}
>
  <div class="nectar-scrolling-text-inner">
    {
      items.map((_, i) => (
        <div class="nectar-scrolling-text-inner__text-chunk" aria-hidden={i > 0 ? 'true' : undefined}>
          <slot />
        </div>
      ))
    }
  </div>
</div>
